pagenum= number of pages to read
vec.names= names of workbook pages

demo.tmp <- function(pagnum, vec.names) {
        for (i in 1:pagnum) {
        import.data(FileName = "C:\\testspl.xls",
        FileType = "Excel",
        ColNames = "",
        Format = "",
        TargetStartCol = "1",
        DataFrame = vec.names[i],
        NameRow = "0",
        StartCol = "1",
        EndCol = "12",
        StartRow = "1",
        EndRow = "8",
        Delimiters = ", \\t",
        SeparateDelimiters = F,
        PageNumber = paste(i),
        RowNameCol = "0",
        StringsAsFactors = "Auto",
        VLabelAsNumber = F,
        DatesAsDoubles = F,
        Filter = "",
        OdbcConnection = "",
        OdbcSqlQuery = "")}}

