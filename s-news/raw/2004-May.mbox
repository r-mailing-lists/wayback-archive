           }
  if (xmax<0)
    PROBLEM "The maximum value (%ld) is negative.",xmax ERROR;

  /*Create a new s_object, set its length and get a
   C integer pointer to it */
  sobjSeq= NEW_INTEGER(0);
  SET_LENGTH(sobjSeq, xmax);
  seq=INTEGER_POINTER(sobjSeq);

  for (i=0;i<xmax; i++){
    seq[i]=i+1;
                       }
  return(sobjSeq);
}
