A while ago I wrote the following function to do plotting with
the sense of axes reversed.  You may find that it does what you want.

                                cheers,

                                        Rolf Turner
                                        rolf at math.unb.ca

rplot <- function(x, y, xrev = F, yrev = T, xside = if(yrev) 3 else 1,
                  yside = if(xrev) 4 else 2, xlab = NULL, ylab = NULL,
                  bty = NULL, ...)
{
#
# Function rplot --- r for ``reverse'' (to reverse the direction
# of axes.  Revised 1/5/97.
#
        xname <- if(is.null(xlab)) deparse(substitute(x)) else xlab
        yname <- if(is.null(ylab)) deparse(substitute(y)) else ylab
        y1 <- if(xrev) rev(y) else y
        y1 <- if(yrev)  - y1 else y1
        plot(x, y1, axes = F, xlab = xname, ylab = yname, ...)
        if(xrev)
                axis(xside, at = pretty(x), labels = rev(pretty(x)))
        else axis(xside)
        if(yrev)
                axis(yside, at = pretty( - y), labels = rev(pretty(y)))
        else axis(yside)
        if(!is.null(bty))
                box(bty = bty)
        invisible()
}

