Kin,

You can solve for rhat independently of xhat by noticing that the recurrence
relation for 
y=1/(rhat-c) is y[n+1] = 1 + c*y[n] so that y[n]=1+c+c^2+...+c^(n-1). It's
not too difficult to get an explicit expression for xhat in terms of x, rhat
and its cumulative products, i.e.
xhat[n+1] = (R[1] x[1] / rhat[1] + R[2] x[2] /rhat[2] + ... + R[n] x[n]
/rhat[n])/R[n]
with R[n] = rhat[1] * rhat[2] * ... * rhat[n]. Below is one way to implement
it.

fun.recursive <- 
function()
{
        c <- 0.3
        xhat <- NULL
        rhat <- NULL
        set.seed(10)
        x <- rnorm(10, 0, 1)
        for(i in 1:10) {
                if(i == 1)
                        xhat[i] <- 0
                if(i == 1)
                        rhat[i] <- 1 + c
                else rhat[i] <- 1 + c - c/rhat[i - 1]
                if(i == 1)
                        xhat[i + 1] <- (x[i] - xhat[i])/rhat[i]
                else xhat[i + 1] <- (x[i] - xhat[i])/rhat[i - 1] 
# is the previous line correct? you are reusing rhat[1].
        }
        rbind(xhat,rhat)
}
fun.nonrecursive <- 
function()
{
        c <- 0.3
        set.seed(10)
        n <- 10
        x <- rnorm(n, 0, 1)
        y <- cumsum(cumprod(rep(c, n))/c)
        rhat <- c + 1/y
        rhat1 <- c(rhat[1], rhat)[1:n] # see comment in fun.recursive
        R <- cumprod( - rhat1)
        xhat <- c(0, cumsum((R * x)/rhat1)/R)
        rbind(xhat, rhat)
}
res1<-fun.recursive()
res2<-fun.nonrecursive()
range(res1-res2)
[1] -4.440892e-016  4.440892e-016
> unix.time(fun.recursive(10000))
[1] 10.5
> unix.time(fun.nonrecursive(10000))
[1] 0.0625

