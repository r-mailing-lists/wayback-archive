> wl.scan
function(file = "clipboard")
{
#
# Scan sounding data
#
# 0.) Set up "matrify" function. This takes a character string (or vector of 
string
s) containing
# data, and produces the corresponding matrix. If "numeric" is TRUE make it 
numeric.
matrify <- function(str.vec, numeric = T)
{
if(length(str.vec) > 1)
zap <- paste(str.vec, collapse = " ")
else zap <- str.vec
zap <- unlist(unpaste(zap, sep = " "))
if(numeric)
matrix(as.numeric(zap[zap != ""]), length(str.vec), byrow = T)
else matrix(zap[zap != ""], length(str.vec), byrow = T)
}
# 1.) Read in file, count lines, indentify numbers of those starting with RAW.
ff <- scan(file, sep = "\n")
n <- length(ff)
raw <- (1:n)[substring(ff, 1, 3) == "RAW"]
#
# Get date/time line; process header lines. Skip location for now. scan()
# omits blank lines.
#
date.time <- ff[raw[1] + 2]
raw.head.1 <- ff[raw[1] + 3]
raw.head.2 <- ff[raw[1] + 4]
raw.head <- paste(matrify(raw.head.1, F), matrify(raw.head.2, F), sep = ".")
#
# That seemed like a lot of trouble. Are the headers always the same?
#
# Identify starting and finishing points for other data.frames.
# 
mandatory <- (1:n)[substring(ff, 1, 9) == "MANDATORY"]
mand.head <- matrify(ff[mandatory[1] + 1], F)
raw.starts <- raw + 5
raw.ends <- mandatory - 1
significant <- (1:n)[substring(ff, 1, 11) == "SIGNIFICANT"]
signif.head <- matrify(ff[significant[1] + 1], F)
mand.starts <- mandatory + 2
mand.ends <- significant - 1
termination <- (1:n)[substring(ff, 1, 11) == "TERMINATION"]
signif.starts <- significant + 2
signif.ends <- termination - 1
#
# Set up list for output
#
out.count <- length(raw.starts) + length(mand.starts) + length(signif.starts)
out <- vector("list", out.count)
names(out) <- c(paste("raw", 1:length(raw.starts), sep = "."), paste("mand", 1:
length(mand.starts), sep = "."), paste("signif", 1:length(signif.starts),
sep = "."))
for(i in 1:length(raw.starts)) {
raw.rows <- raw.starts[i]:(raw.ends[i])
thing <- matrify(ff[raw.rows])
dimnames(thing) <- list(NULL, raw.head)
out[[paste("raw", i, sep = ".")]] <- data.frame(thing)
}
for(i in 1:length(mand.starts)) {
mand.rows <- mand.starts[i]:(mand.ends[i])
thing <- matrify(ff[mand.rows])
dimnames(thing) <- list(NULL, mand.head)
out[[paste("mand", i, sep = ".")]] <- data.frame(thing)
}
for(i in 1:length(signif.starts)) {
signif.rows <- signif.starts[i]:(signif.ends[i])
thing <- matrify(ff[signif.rows])
dimnames(thing) <- list(NULL, signif.head)
out[[paste("signif", i, sep = ".")]] <- data.frame(thing)
}
out
}

