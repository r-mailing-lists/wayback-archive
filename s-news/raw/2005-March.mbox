From rmh at temple.edu  Sat Mar 12 21:04:03 2005
From: rmh at temple.edu (Richard M. Heiberger)
Date: Sat, 12 Mar 2005 16:04:03 -0500
Subject: Re: Trellis Panel= for varying models
Message-ID: <460fd43.dc0edb92.81c4d00@po-d.temple.edu>

x <- -25:25
y <- 2 + x + 3*x^2 + rnorm(51, s=100)

yhat.lin  <- lm(y ~ x)
yhat.quad <- lm(y ~ x + x^2)

anova(yhat.lin)
anova(yhat.quad)

tmp <- data.frame(x=rep(x,2),
                  y=rep(y,2),
                  yhat=c(
                    fitted(yhat.lin),
                    fitted(yhat.quad)),
                  model=rep(c("lin","quad"), c(51,51)))

xyplot(y ~ x | model, data=tmp,
       main="same data, different models",
       panel=function(x, y, ...) {
         panel.xyplot(x, y, ...)
         cell <- get("cell", frame=sys.parent())
         panel.labels <- get("panel.labels", frame=sys.parent())
         panel.xyplot(x, tmp$yhat[tmp$model==panel.labels[cell]], type="l", ...)
       })

tmp2 <- tmp
tmp2$y[52:102] <- 3*x
xyplot(y ~ x | model, data=tmp2,
       main="different data, potentially different models",
       panel=function(x, y, ...) {
         panel.xyplot(x, y, ...)
         lin <- lm(y ~ x)
         quad <- lm(y ~ x + x^2)
         if (coef(summary(quad))[3,4] < .05)
           panel.xyplot(x, fitted(quad), type="l")
         else
          panel.xyplot(x, fitted(lin), type="l")
       })

