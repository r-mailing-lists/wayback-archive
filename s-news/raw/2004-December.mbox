Are these what you are looking for?

If not, please send an executable example of what you need.

Rich

tmp <- data.frame(ttime=1:20,
                  y=c(rnorm(10), 1+rnorm(10)),
                  a=rep(c("base","intv"),c(10,10)))

tpgsl <- trellis.par.get("superpose.line")
tpgsl <- as.data.frame(tpgsl)[1:length(levels(tmp$a)),]

xyplot(y ~ ttime, groups=a, data=tmp,
       panel="panel.superpose", type="l",
       key=list(text=c(list(levels(tmp$a)), tpgsl),
         line=tpgsl,
         border=T))

tmp2 <- data.frame(y=rnorm(10), x=rnorm(10))

xy.lm <- lm(y ~ x, data=tmp2)
xy.rr <- rreg(tmp2$x, tmp2$y)

p.lm <- predict(xy.lm)

xyplot(y ~ x, data=tmp2,
       p.lm=p.lm, p.rr=xy.rr$fitted.values,
       pch=16,
       panel=function(x, y, ..., p.lm, p.rr) {
         panel.xyplot(x, y, ...)
         panel.xyplot(x, y=p.lm, type="l", col=2)
         panel.xyplot(x, y=p.rr, type="l", col=3)
       },
       key=list(text=c(list(c("lm","rreg")), tpgsl),
         line=tpgsl,
         border=T))

