+ n *
      w)) * (a + x + n/(1 + n * w) * (y - u)^2))) * (u + n * w * y))/(1 + n
* w) *
      (x^((n - 3)/2)) * (a + x + n/(1 + n * w) * (y - u)^2)^( - (g + n)/2)
   }
   , lower = IL, upper = IU, x = x)$integral
  }
  ))
 }
 r1 <- integrate(f = fun, lower = 0, upper = Inf)$integral
 return(r1)
}

