with the result: 

test.aggregate <- function(seed = 1, samp = 1:10, nrow = 1000, ncol = 10) { 
        ## tests aggregate() 
        set.seed(seed)   
        data <- data.frame(matrix(sample(samp,nrow*ncol,replace = T),nrow =
nrow)) 
        agg.data <- aggregate.data.frame(rep(1,nrow(data)), by = data, FUN =
sum)[,1:ncol(data)] 
        print(sapply(data,function(x) length(unique(x))) ==
sapply(agg.data,function(x) length(unique(x)))) ## Compare unique values 
        print(c( 
                length(unique(apply(data,1,function(x)
