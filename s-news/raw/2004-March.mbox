                        Alpha2 * Conc[(CSize1 +
                        3):(CSize), 1] + Alpha2 *
                        Conc[(CSize1 + 1):
                        (CSize - 2), 1]
                BMatrix[CSize, 1] <- Conc[
                        CSize, 1] * ((1/dt) -
                        (D2/(dx2^2))) + Conc[
                        (CSize - 1), 1] * (
                        D2/(2 * (dx2^2)))
                #Now we need to get the solution for the ConcVector, AMatrix 
Defined Above
                Conc <- solve(AMatrix, BMatrix)
