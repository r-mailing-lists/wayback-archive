glm1 <- glm(response ~ factor1 + factor2 + variable,
family=binomial(link=logit), na.action=na.omit)

binenv <- function(object, nsamples=19, alpha=.05){

        n <- length(resid(object, type="deviance"))
        p.hat <- predict(object, type="response")

        sim.resp <- matrix(ifelse(rep(p.hat, nsamples)<runif(n*nsamples),
0,1), ncol=nsamples)

        app.func <- function(x, object) {
                glm.obj <- glm( x ~ -1 + model.matrix(object),
                  family = family(object), na.action = na.omit)

                  glm.obj$residuals
                  #resid(glm.obj, type="deviance")

        }
        return(sim.resid <- apply(sim.resp, 2, app.func, object))
}

binenv(glm1)

