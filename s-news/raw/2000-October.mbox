my.dates <- function(x, out.format = "m/d/year", misschar=c("NA",""), ...)
{
####  misschar: vector of character strings which denote missing dates in
input x.
        if(is.numeric(x))
                chron(dates. = trunc(x), out.format = out.format, ...)
        else if (is.character(x)){
                mm <- match(x,misschar)
                which.miss <- which(!is.na(mm))
                if (length(which.miss)==0)
                        trunc(chron(dates. = x, out.format = out.format,
...))
                which.not <- which(is.na(mm))
                x.miss <- x[which.miss]
                xx <- x[which.not]
                retval <- vector("numeric",length=length(x))
                retval[which.miss] <- NA
                dts <- dates(xx,...)
                retval[which.not] <- as.vector(dts)
                dates(retval,out.format=out.format, ...)
        }
        else trunc(chron(dates. = x, out.format = out.format, ...))
}

