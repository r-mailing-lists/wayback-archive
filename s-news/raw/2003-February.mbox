Pete Meyer wrote:
> Running Splus 6.1 Rel. 1 under XP.
>
>
> The following four sets of code purport to fit the same model
>
> and then provide the predictions.  The one done in immediate
>
> mode succeeds, but all others fail.  func.2() is interesting
>
> because the glm evaluation is wrapped inside of the predict.glm
>
> evaluation.
>
>
> yy <- rpois(n=100,lambda=100)
>
> xx <- 1:100
>
> predict.glm(glm(yy ~ ns(xx,knots=c(20,30,40),B=T),family=poisson),se.fit=T)
>
> #################################################
>
> func.1 <- function(){
>
> y <- rpois(n=100,lambda=100)
>
> x <- 1:100
>
> mod.glm <- glm(y ~ ns(x,knots=c(20,30,40),B=T),family=poisson)
>
> predict.glm(mod.glm,se.fit=T)
>
> }
>
> func.1()
>
> traceback()
>
> #################################################
>
> func.2 <- function(){
>
> y <- rpois(n=100,lambda=100)
>
> x <- 1:100
>
> predict.glm(glm(y ~ ns(x,knots=c(20,30,40),B=T),family=poisson),se.fit=T)
>
> }
>
> func.2()
>
> traceback()
>
> #################################################
>
> func.3 <- function(){
>
> y <- rpois(n=100,lambda=100)
>
> x <- 1:100
>
> frm <- data.frame(y,x)
>
> predict.glm(glm(y ~ ns(x,knots=c(20,30,40),B=T),family=poisson,
>
> data=frm),se.fit=T)
>
> }
>
> func.3()
>
> traceback()
>
>
> Any suggestions how to overcome the apparent scoping
>
> difficulties?
>
>

You'll need to assign "x", "y", and/or "frm" to the local frame. As in:

func.2 <- function(){
  y <- rpois(n=100,lambda=100)
  x <- 1:100
  assign("y", y, frame = 1)
  assign("x", x, frame = 1)
  predict.glm(glm(y ~ ns(x,knots=c(20,30,40),B=T),
                  family=poisson),
                  se.fit=T)
}
func.2()
#################################################
func.3 <- function(){
  y <- rpois(n=100,lambda=100)
  x <- 1:100
  frm <- data.frame(y,x)
  assign("frm", frm, frame = 1)
  predict.glm(glm(y ~ ns(x,knots=c(20,30,40),B=T),
                  family=poisson,
                  data=frm),
                  se.fit=T)
}

