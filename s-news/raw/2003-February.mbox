See ?arima.diag.

ma <- arima.sim(model=list(ma=c(-.5, -.25)))
ma.fit <- arima.mle(ma, model=list(ma=c(-.5, -.25)))
ma.resid <- arima.diag(ma.fit, resid = TRUE, plot = FALSE)$resid
ma.fitted <- ma - ma.resid

