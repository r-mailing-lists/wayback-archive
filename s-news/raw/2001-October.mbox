> A.df <- data.frame(c("one", "two", "one", "three"), c(45, 0, 8, 89))
> names(A.df) <- c("a1", "a2")
> > A.df
>      a1 a2
> 1   one 45
> 2   two  0
> 3   one  8
> 4 three 89
>
> B.df <- data.frame(c("one", "two"), c(1, 2))
> names(B.df) <- c("b1", "b2")
> > B.df
>    b1 b2
> 1 one  1
> 2 two  2
