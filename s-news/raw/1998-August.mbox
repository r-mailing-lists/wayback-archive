>>      d.pos <- d.pos/(sigma * (t.exp - t)^0.5)
>>      d.neg <- d.pos - sigma * (t.exp - t)^0.5
>>      s * pnorm(d.pos) - x * exp( - r * (t.exp - t)) * pnorm(d.neg)
