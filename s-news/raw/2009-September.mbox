Dear Simona,

I have performed S+ Kendall with the example of Conover:

> X <- c(68,70,71,71,72,77,77,86,87,88,91,91)

> Y <- c(64,65,77,80,72,65,76,88,72,81,90,96)

> cor.test(X,Y, method="k")

                
Kendall's rank correlation tau 

data:  X and Y 

normal-z = 2.567, p-value = 0.0103 

alternative hypothesis:  tau is not equal to 0 

sample estimates:

       tau 

 0.5606061

Conover gives: 0.5606.

If you wish to check the program:

> cor.test

function(x, y, alternative = "two.sided", method = "pearson")

{

                
stop.on.bdObject(x)

                
stop.on.bdObject(y)

                
if(is(x, "series"))

                
                 x
<- as.matrix(x@data)

                
if(is(y, "series"))

                
                 y
<- as.matrix(y@data)

                
vark <- function(x, y)

                
{

                
                 #
variance of K for Kendall's tau

                
                 ties.x
<- as.double(rle(sort(x))$lengths)

                
                 ties.y
<- as.double(rle(sort(y))$lengths)

                
                 n
<- as.double(length(x))

                
                 t1
<- n * (n - 1) * (2 * n + 5)

                
                 t2
<- sum(ties.x * (ties.x - 1) * (2 * ties.x + 5))

                
                 t3
<- sum(ties.y * (ties.y - 1) * (2 * ties.y + 5))

                
                 v1
<- (t1 - t2 - t3)/18

                
                 t1
<- sum(ties.x * (ties.x - 1) * (ties.x - 2))

                
                 t2
<- sum(ties.y * (ties.y - 1) * (ties.y - 2))

                
                 v2
<- (t1 * t2)/(9 * n * (n - 1) * (n - 2))

                
                 t1
<- sum(ties.x * (ties.x - 1)) * sum(ties.y * 

(ties.y - 1))

                
                 v3
<- t1/(2 * n * (n - 1))

                
                 v1
+ v2 + v3

......

                
                 if(imeth
== 2) {

                
                 
               
# a fast, efficient way to compute 

concordant pairs:

                
                 
               
concordant.sum <- 

sum(unlist(lapply(seq(along = x), function(i, x, y)

                
                 
               
sum(sign((x[i] - x[1:i]) * (y[i] - y[1:i]))), x, 

y)))

                
                 
               
# Kendall's tau:

                
                 
               
coef <- (2 * concordant.sum)/(n * (n - 1))

                
                 
               
attr(coef, "names") <- "tau"

                
                 
               
#stddv <- sqrt((n * (n - 1) * (2 * n + 

5))/18)

                
                 
               
