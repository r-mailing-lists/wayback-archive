Subject: Re: Image plots with set color values... (Correction)
Message-ID: <008001c226aa$ccefd240$2701a8c0@joshbtosh>

A quick correction is needed for this function:

image.sym <- function(x, middle){
         image(x)
         test <- max(x, abs(x))
         t <- abs((max(mat)-middle)/(middle - min(mat)))
         if(test == max(x)){
              numShd <- paste("49", as.character(round(t*49)), sep = ",")
         }
         else {
              numShd <- paste(as.character(round((1/t)*49)), "49", sep =
",")
         }
         guiModify("GraphSheet", Name = "GSD2",
          ImageColorTable = "255,0,0|0,0,0|0,255,0",
         NumImageColors = "3",
         NumImageShades = numShd)
}

Josh

