You're right. There was a bug in my code that I never caught before. I
don't use it very much since fisher.test exists.

fisher <- function(x,a=x[1,1],b=x[1,2],c=x[2,1],d=x[2,2]) {
  #       a | b
  #  x = -------
  #       c | d
  N <- sum(x)
  p <- dhyper(a,a+b,c+d,a+c)
  x <- seq(max(0,a+b-(N-a-c)),min(a+b,a+c))
  phyp <- dhyper(x,a+b,c+d,a+c)
  # sum(phyp[phyp<p])+p :: BUG
  sum(phyp[phyp<=p])    ## FIX
}

> xx <- matrix(c(1, 4, 50000. - 1, 50000. - 4), 2, 2)
