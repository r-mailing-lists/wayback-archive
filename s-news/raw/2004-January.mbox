From SMohanty at PRDUS.JNJ.COM  Thu Jan 15 21:41:09 2004
From: SMohanty at PRDUS.JNJ.COM (Mohanty, Surya [PRDUS])
Date: Thu, 15 Jan 2004 16:41:09 -0500
Subject: Re: generating multivariate binary outcomes
Message-ID: <9A2EB4EA9633D611A4820002A5411AE82D38E0@JANUSTIEXS1.janus.jnj.com>

Hope this helps....

############################################################################

# Function      deprv: Generates dependent Poisson and Bernoulli vectors

#

#               Input: dist ("pois"  or "bern")

#               rho  : correlation matrix

#               n    : number of obs

#               mean : vector of mean

#

#               OUTPUT: data -- vector of dependent rvs

#

#               Supplemetary programs : gendec, calmat, genvec

#

#               gendec: Peels values

#               calcmat: peels matrix

#               genvec: takes the peeled components from gendec & calmat

#               and puts them together

#

#       NOTE: Fix program to give error if dimensionality incongruent

############################################################################

deprv_function(dist="pois", rho, n, mean){

   if(dist=="pois") {

   covar_diag(sqrt(mean))%*%rho%*%diag(sqrt(mean))

   a_gendec(covar)

   b_genvec(n, a$vec, a$s)

   out_b$fv

   }

   if(dist=="bern") {

      covar_log(1+diag(sqrt((1-mean)/mean))%*%rho%*%diag(sqrt((1-mean)/mean)))

      a_gendec(covar)

      b_genvec(n, a$vec, a$s)

      out_1*(b$fv == 0)

      }

   list(data="">

   }

gendec_function(xx){

   vec_rep(0, 1000)

   s_matrix(rep(0, 1000*nrow(xx)), 1000, nrow(xx))

   l_0

   while(any(xx>0)){

      l_l+1

      a_calcmat(xx)$nho

     # print(a)

      xx_xx-a*(vec[l]_min(xx*(a!=0) + 999*(a==0)))

      s[l,]_1*(apply(a, 1, sum)>0)

      }

   list(vec=vec[1:l], s=s[1:l, ])

   }

calcmat_function(rho){

   k_match(1, 1*(diag(rho) > 0))

   if(sum(x_which(  rho[k,]==0)) !=0){

      rho[x,]_0

      rho[,x]_0

      }

      list(nho=1*(rho>0))

   }

genvec_function(n, vec, s){

l_length(vec)

dt_matrix(rep(0, n*l), n, l)

for(i in c(1:l)){

   dt[,i]_rpois(n, vec[i])

   }

fv_dt%*%s

list(fv=fv)

}

  

