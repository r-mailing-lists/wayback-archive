The following function rings a bell on my 
Windows 2000 PC and should not interfere 
any of your existing S-PLUS objects:

bell <- 
  function(N = 5)
{

  while(exists(bellfile <- paste("bell", sample(9999, 1), sep = ""),
               where = 1)) {}
  on.exit(remove(bellfile))
  assign(bellfile, rep("\007", N), where = 1, immediate = T)
  commandString <-
    paste("dos(\"type .\\\\.Data\\\\",
          bellfile, "\", out = F, min = T       )",
          sep = "")
  eval(parse(text = commandString))
                
}

In S-PLUS:

> bell()
# rings 5 times

> bell(2)
# rings twice

