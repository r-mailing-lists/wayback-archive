--------------------------------------------------------------

 

originalfunction<-function(invector)

 

outvector<-invector

 

for ( i in 
2:length(invector) ) {

 

if  ( 
invector[i] < 1 ) {

 

outvector[i]_invector[i]*outvector[i-1]

 

}

 

 

return(outvector)

 

-------------------------------------------------------------------

 

almostworks<-function(invector) 
{

 

