Would the following work for you?

p <- 0.7
n <- 20
x <- 0:n
px <- dbinom(x, n, p)
z <- seq(min(x), max(x), length = 200)
pz <- dnorm(z, n * p, sqrt(n * p * (1 - p)))
barplot(px, x - 0.5, histo = TRUE, ylim = range(px, pz), col = 0)
lines(z, pz)

--sundar

