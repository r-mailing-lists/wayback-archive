From dhomiak at xcaliber.com  Mon Jan 29 22:05:16 2001
From: dhomiak at xcaliber.com (David Homiak)
Date: Mon, 29 Jan 2001 16:05:16 -0600
Subject: RE: looking for the C-routine 'spline_basis'
Message-ID: <1BDB01B13696D411BD6200D0B7C854EA09E841@chi-prd-mail1.xcaliber.com>

See splines.c in the library/splines/src directory of the R 1.1.1 source
code, available from the Downloads section of http://www.r-project.org/.
Here is the function you requested, but you will want to look at the rest of
the package.

void spline_basis(double *knots, Sint *ncoeff, Sint *order,
                  double *xvals, Sint *derivs, Sint *nx,
                  double *basis, Sint *offsets)
{                               /* evaluate the non-zero B-spline basis */
                                /* functions (or their derivatives) at */
                                /* xvals.  */
  Sint n = *nx, i, j;
  double *dpt, *coeff, *last = knots + *ncoeff;

  orderm1 = *order - 1L;
  rdel = Calloc(orderm1, double);
  ldel = Calloc(orderm1, double);
  coeff = Calloc(*order, double);
  dpt = (knots += *order);      /* first *order knots must be <= all xvals
*/
  for( ; n--; xvals++, derivs++) {
    while(dpt < last && *dpt <= *xvals) dpt++;
    if (*derivs) {              /* slow method for derivatives */
      for(i = 0; i < *order; i++) {
        for(j = 0; j < *order; j++) coeff[j] = 0;
        coeff[i] = 1;
        *basis++ = evaluate(dpt, *xvals, coeff, (Sint) *derivs);
      }
    }
    else {
      basis_funcs(dpt, *xvals, basis); /* fast method for value */
      basis += *order;
    }
    *offsets++ = (Sint)(dpt - knots);
  }
  Free(ldel); Free(rdel); Free(coeff);
}

