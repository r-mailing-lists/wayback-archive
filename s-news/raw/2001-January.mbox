function(x)
{
        .expr1 <- abs.1(x)
        .value <- sin(.expr1)
        .actualArgs <- match.call()["x"]
        if(all(unlist(lapply(as.list(.actualArgs), is.name)))) {
                .grad <- array(0, c(length(.value), 1), list(NULL, "x"))
                .grad[, "x"] <- (cos(.expr1)) * (abs.1deriv(x))
                dimnames(.grad) <- list(NULL, .actualArgs)
                attr(.value, "gradient") <- .grad
        }
        .value
