Here are two variants of your request.

A <- data.frame(Period=c("W1","W2","W3"),
                Data=c(4,5,6))

B <- data.frame(W1="A",
                W2="B",
                W3="C")

BB <- diag(length(t(B)))
BBB <- rep("", length(BB))
BBB[as.logical(BB)] <- t(B)
BBB
dim(BBB) <- dim(BB)
dimnames(BBB) <- list(names(B), names(B))
BBB

result1 <- cbind(A, BBB)
result1

CCC <- diag(as.vector(t(B)))
dimnames(CCC) <- list(names(B), names(B))
CCC
result2 <- cbind(A, CCC)
result2

