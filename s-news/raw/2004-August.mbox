     M123 <- glm(Side~ABM+FBR+GRT, poisson)
     M12 <- glm(Side~ABM+FBR, poisson)
     M13 <- glm(Side~ABM+GRT, poisson)
     M23 <- glm(Side~FBR+GRT, poisson)

Then consider the following: 

     anova(M123, M23) # significant if ABM provides information not in 
FBR+GRT

     anova(M123, M13) # significant if FBR provides information not in 
ABM+GRT

     anova(M123, M12) # significant if GRT provides information not in 
ABM+FBR

If for some reason you can't get M123 but you can get M12, for example, 
you can still consider the following: 

     anova(M12, Model1)# significant if FBR provides information not in 
