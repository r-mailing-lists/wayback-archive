  As you have heard, you can put the results together in a list 
and then return the list.

myfun <- function(){
         A <- OLS(y ~ x1 + x2)
         B <- OLS(y ~ X3 + x4)
         ans <- list(A = A, B = B)
         return(ans)
                }

