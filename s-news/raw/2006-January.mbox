How about (assuming `x' is your data.frame):

x$new.var <- ifelse(x$int.year >= x$year, 1, 0)
x$new.var.2 <- ifelse(x$int.year >= x$year, x$year - x$int.year + 1, 0)

HTH,

--sundar

