"swatch" <-
function (textlabel = TRUE, textlabel.color = 0)
{
   xylowerleft <- expand.grid(0:9, 0:9)
   colors <- as.numeric(paste(xylowerleft[, 2], xylowerleft[,
       1], sep = ""))
   xcorners <- cbind(xylowerleft[, 2], xylowerleft[, 2], xylowerleft[,
       2] + 1, 1 + xylowerleft[, 2])
   ycorners <- cbind(xylowerleft[, 1], xylowerleft[, 1] + 1,
       xylowerleft[, 1] + 1, xylowerleft[, 1])
   plot(0:10, 0:10, col = 1, type = "n", xlab = "10's digit",
       ylab = "1's digit")
   for (i in 1:(dim(xylowerleft)[1])) {
       polygon(xcorners[i, ], ycorners[i, ], col = colors[i])
   }
   if (textlabel == T) {
       xycenters <- xylowerleft + 0.5
       text(xycenters[, 2], xycenters[, 1], labels = colors,
           adj = 0, col = textlabel.color)
   }
}

