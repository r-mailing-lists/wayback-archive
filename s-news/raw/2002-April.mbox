# A function to simulate N GBM returns from a Normal distribution
# (of specified mean return "m" and
# a daily volatility "vol" expressed as a percentage)
# and convert it to a price path beginning with value "start"

sim.Npath <- function(N, vol=10, m=0, start=2.50) {
   r <- rnorm(N-1, m, vol/(100*sqrt(250)))   # continuity correction:
   # start*exp(cumsum(c(0,r)) - (0:(N-1))/2*(vol/(100*sqrt(250)))^2)
   start*exp(cumsum(c(0,r)))
}

