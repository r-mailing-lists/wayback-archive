Will changing zlim work?

Example:

df1 <- list(x=1:20,y=1:20,z=matrix(rnorm(400),20,20))
df2 <- df1
df2$z <- 2*df2$z
graphsheet(num.image.colors=2,
           num.image.shades="64",
           image.color.table="255,0,0|255,255,0",
           width=10,height=10)
image(df1,zlim=range(df2$z))
image(df2)

