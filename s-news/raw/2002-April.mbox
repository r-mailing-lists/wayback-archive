Remove all formatting. By default Splus will justify characters to the
left and numbers to the right:

# no format() or I()
data<-data.frame(str=c("ab","a","b"),num=c(1,100,2))
write.table(data,file="clipboard",sep="\t",dimnames.write="col")
tmp<-read.table(file="clipboard",sep="\t",header=T,row.names=NULL,as.is=T)

> tmp$str
[1] "ab" "a"  "b"

