aov.obj<-aov(y~x*b+c,data,qr=T)

# same resulst as in BMDP 2V
contrast.test(aov.obj,"x",data,type="marginal.means")
           SS  Estimates StdError          t resid.df          P 
.L 2561.52381  19.327585 8.220064  2.3512696       10 0.04055273
.Q   66.78261  -3.265986 8.602594 -0.3796513       10 0.71214228

# note: the estimates are the same as in SPSS but  the SE 
# is different for SPSS: 25.469 ! and 8.689 
contrast.test(aov.obj,"x",data,type="adj.means")
         SS Estimates StdError          t resid.df         P 
.L 378.0000 -7.424621 8.220064 -0.9032316       10 0.3876431
.Q 163.0435 -5.103104 8.602594 -0.5932052       10 0.5662177

#
# function computing the contrasts for a factor in an ANOVA
# 
# terms: select the factor for which the contrasts must be tested
# type: select how the means for each levels of this factor must
#       be computed. Possible values are "marginal.means", "dummy",
#        "means","adj.means",and "effects".
#

contrast.test<-function(aov.obj,term,data,type="marginal.means"){
        Terms<-aov.obj$terms
        response<-unlist(unpaste(attr(Terms,
                "variables")))[attr(Terms,"response")]
        # means and size of each group
        means<-if(type=="dummy") dummy.coef(aov.obj)[[term]] 
                else if (type=="marginal.means") tapply(
                        data[[response]],data[[term]],mean)
                else model.tables(aov.obj,type=type)$tables[[term]]
        nobs<-as.vector(table(data[[term]]))
        # compute estimates for all contrasts
        contrast<-contrasts(data[[term]])
        estimates<-means%*%contrast
        # compute sum of squares for all contrasts
        ss<-colSums(contrast*means)^2/colSums(contrast^2/nobs)
        # compute standard error for all contrasts
        cont <-sapply(levels(data[[term]]),
                function(level,dat)dat==level,data[[term]])
        cont <- cont %*%(contrast/nobs)
        se.cont<-se.contrast(aov.obj,contrast=cont,data=data)
        # t.test
        q<-estimates/se.cont
        df<-aov.obj$df.residual
        Pval<-1-pf(q^2,1,df)
        #
        res<-cbind(ss,as.vector(estimates),as.vector(se.cont),
                as.vector(q),rep(df,length(nobs)-1),Pval)
        dimnames(res)<-list(dimnames(se.cont)[[2]],
                c("SS","Estimates","StdError","t","resid.df","P"))
        res
}

