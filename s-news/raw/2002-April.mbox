                3.74,3.83,3.87,4.08,4.31,3.98,3.86,3.71))
data$tr<-factor(data$tr)

#
# 1) manual computations of F test for contrast c(1/3,1/3,1/3,-1)
#

# contrast estimate
sum(c(1/3,1/3,1/3,-1)*tapply(data$weight,data$tr,mean))
 -0.2811508

# contrast sum of square
sum(c(1/3,1/3,1/3,-1)*tapply(data$weight,data$tr,mean))^2/
sum(c(1/3,1/3,1/3,-1)^2/as.vector(table(data$tr)))
0.4561725

# residual sum of squares
sum((rep(tapply(data$weight,data$tr,mean),as.vector(table(data$tr)))-
        data$weight[order(data$tr)])^2)
1.034405 

