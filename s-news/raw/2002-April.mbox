       tr  3  0.578209 0.1927363  4.65815 0.01015794
   tr: c1  1  0.460769 0.4607686 11.13608 0.00265046
Residuals 25  1.034405 0.0413762                    

#
# 3) 2nd way of computing F test manually
#

# contrast standard error   
cont <-sapply(levels(data$tr),function(level)data$tr==level)
cont <- cont %*%(contrasts(data$tr)/as.vector(table(data$tr)))
colSums(cont)
se.contrast(fit,contrast=cont,data=NULL)
0.08467399 0.08045941 0.07424449

# estimate
sum(contrasts(data$tr)[,1]*tapply(data$weight,data$tr,mean))
-0.2811508

# t test and F test
-0.2811508/0.08467399 = -3.320392
(-3.320392)^2 = 11.025

