quantros.quartersRow <- function(df) {
        df$quarters <- quarters(df$ADMITDATE)
        output <- tapply(df$ANSWER, df$quarters, function(x) ( sum(x==1) /
 sum(x==1) + sum(x==2) ) )*100 )
        avgScore <- mean(output, na.rm=T)
        output <- append(output, avgScore)
        output <- round(output, 1)
        #adddate <- date()
        #adddate <- null()
        #output <- append(output, adddate )
        output[is.na(output)]<- 0
        output[is.nan(output)] <- 0
        finalOut <- append(output, c(df[1,1],2,df[1,3], df[1,5],
2,df[1,4],df[1,6]),0)
        return(finalOut)
}

