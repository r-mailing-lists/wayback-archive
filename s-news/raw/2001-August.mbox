quantros.quartersRow <- function(df) {
          df$quarters <- quarters(df$ADMITDATE)
          output <- tapply(df$ANSWER, df$quarters, function(x) ( sum(x==1) /
 sum(x==1) + sum(x==2) ) )*100 )
