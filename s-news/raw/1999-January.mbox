>
> patchsq.dll: $(obja) patchsq.mak patchsq.lnk
>    wlink d all SYS nt_dll op m op maxe=25 op q op symf @patchsq.lnk
>    wlib patchsq.lib +patchsq.dll
>
> patchsq.obj: splus\patchsq.c patchsq.mak
>    wcc386 $(CMPL) splus\patchsq.c
>
>
> patchsq.lnk
