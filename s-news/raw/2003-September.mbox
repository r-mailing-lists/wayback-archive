From gary at sabot.com  Thu Sep 11 13:16:42 2003
From: gary at sabot.com (Gary Sabot)
Date: Thu, 11 Sep 2003 13:16:42 +0000
Subject: vector conditionals
Message-ID: <20030911131642.8601.qmail@brain.delphioutpost.com>

ifelse() and switch() are pretty useful, but they do not seem apply to
vectors.  Is there some elegant way to do vector conditionalization in
S that I am missing (sort of like knowing about && but not &)?

I threw together a function that solves my problem for now, but its
pretty ugly.  Its sort of like a "cond" in lisp: ifelse.vec takes
pairs of vector booleans and (usually vector) value expressions, and
pieces together a value from that, kind of like this:

> ifelse.vec(c(a=F,b=T,c=F,d=F,e=F,f=T), 1:6, 
             c(T,F,F,F,F,F),7:12,
             c(F,F,T,F,T,T),12,
             T,"default")
   a   b    c         d    e   f 
 "7" "2" "12" "default" "12" "6"
> 

Its new and probably buggy, but perhaps it will be of use to someone (or
maybe you will have some suggested improvements):

#Take alternating bools and vals.  All bools must be vectors of the
#same length.  All values must be of the same length or atomic.
#NA for boolean becomes F
#Optional final pair can be an else clause, introduced by an atomic bool that 
is T.
#Result has names of the first bool.
ifelse.vec <- function(bool1,val1,...) 
{
   default <- NA
   arg.count <- nDotArgs(...)
   if((arg.count%%2)!=0) {
      #odd number of args, error
      stop("odd number of arguments to ifelse.vec")
   }
   dot.pair.count <- arg.count/2
   result <- rep(default,length(bool1))
   needs.a.value <- rep(T,length(bool1))
   l <- length(bool1)
   result <- 
ifelse.vec.internal(l,result,needs.a.value,dot.pair.count,bool1,val1,...)
   names(result) <- names(bool1)
   result
}

ifelse.vec.internal <- 
function(l,result,needs.a.value,dot.pair.count,bool1,val1,...) {
   bool1[is.na(bool1)] <- F
   #handle atomic else clause
   if((length(bool1)==1) && bool1) {
      if(length(val1)>1) {
         if(l!=length(needs.a.value)) {
            stop("length of vector value does not match first boolean (final 
clause?)")
         }
         result[needs.a.value] <- val1[needs.a.value]
      } else {
         result[needs.a.value] <- val1
      }
      needs.a.value[] <- F
   } else {
      if(l!=length(bool1)) {
         stop("length of vector bool does not match first boolean")
      }
      update.these <- needs.a.value & bool1
      if(length(val1)>1) {
         if(l!=length(val1)) {
            stop("length of value does not match first boolean")
         }
         result[update.these] <- val1[update.these]
      } else {
         result[update.these] <- val1
      }
      needs.a.value[update.these] <- F
   }
   dot.pair.count <- dot.pair.count-1
   if(dot.pair.count>=0) {
#this might speed things up rarely, but more often slows down the
#typical case, so skip it: if(any(needs.a.value)) {}
      #now recurse without bool1/val1
      result <- ifelse.vec.internal(l,result,needs.a.value,dot.pair.count,...)
   }
   result
}

--gary
