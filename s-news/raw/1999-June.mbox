Hi Mark,
Below is a function that I used long ago for plotting ellipses.  I'm sure it
can be simplified and streamlined. Do check that it is ok.  I think the
centre is at (0,0) and your radii will be related to a and b in the
function.

Regards

tony

> my.plot.ellipse <- function(a, h, b, k, phase = 0)
{
#
# quadratic form is central with coefficients a h b
# in  ax^2 + 2h*xy + by^2 all equal to a constant k
#
 quad.form <- matrix(c(c(a, h), c(h, b)), ncol = 2, byrow = T) #
# rotation angle for ellipse
#
 theta <- 0.5 * (atan((2 * quad.form[1, 2])/(quad.form[1, 1] - quad.form[2,
2])))
 theta <- theta + phase #
# create a standard ellipse, with unit axes
#
 y1 <- vector(length = 101)
 y2 <- vector(length = 101)
 for(i in 0:100) {
  y1[i + 1] <- cos((i * 2 * pi)/100)
  y2[i + 1] <- sin((i * 2 * pi)/100)
 }
#
# now the length of the axes in standard form, then adjust std. ellipse
#
 xa1 <- eigen(quad.form)[[1]][1]/k
 xb1 <- eigen(quad.form)[[1]][2]/k
 xa <- sqrt(1/xa1)
 xb <- sqrt(1/xb1)
 Y <- cbind(y1 * xa, y2 * xb) #
# now rotate the adjusted ellipse
#
 rot.mat <- matrix(c(c(cos(theta), sin(theta)), c( - sin(theta),
cos(theta))), ncol = 2, byrow = T)
 Z <- Y %*% rot.mat
 plot(Z[, 1], Z[, 2], type = "n")
 lines(Z[, 1], Z[, 2]) # points(-2.391, 2.3, pch = 3)
# abline(v = c(-3.21, -1.58), lty = 2)
# abline(h = c(1.83, 2.77), lty = 2)
}

