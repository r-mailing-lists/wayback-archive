outerloop <- function(a, b, c)
{
    n <- length(a)
    assign("a", a, where=1)
    assign("b", b, where=1)
    assign("c", c, where=1)
    assign("innerres", vector(length=n), where=1)
    For(i=1:n, innerres[i] <- innerloop(a[i], b[i], c[i]))
    return(innerres)
}

innerloop <- function(aa, bb, cc) return(aa+bb+cc)

outerloop(c(1, 2, 3), c(2, 3, 4), c(3, 4, 5))
