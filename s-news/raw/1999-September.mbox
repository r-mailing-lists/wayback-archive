> >     + (C1 * sin(2*1*pi*time/52)) + (D1 * cos(2*1*pi*time/52))
> >     + (C2 * sin(2*2*pi*time/52)) + (D2 * cos(2*2*pi*time/52))
> >     + (C3 * sin(2*3*pi*time/52)) + (D3 * cos(2*3*pi*time/52))
