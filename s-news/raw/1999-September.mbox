From cdisdero at statsci.com  Sun Sep 12 04:01:14 1999
From: cdisdero at statsci.com (Chris Disdero)
Date: Sat, 11 Sep 1999 21:01:14 -0700
Subject: [S] RE: OLE automation headaches
Message-ID: <Pine.GSO.3.96.990911205419.26139A-200000@melon>

In response to your query regarding how to access the 'Item' property from
an S-PLUS script, you can use call.ole.method() instead of using
get.ole.property() to call the 'Item' property of an Excel collection
class.  Using call.ole.method() allows you to pass the index argument you
need to get the item.  Below and attached is an example S-PLUS script
which demonstrates this:

# Example S-PLUS code to show how to access the 'Item' property
# of the 'Styles' collection object for an Excel workbook object
# --------------------------------------------------------------
# Written by: Chris Disdero 990911

# Create a new Excel application instance and make it visible
pExcel <- create.ole.object( "excel.application" )
ExcelVisible <- get.ole.property( pExcel, "visible" )$visible
if ( !ExcelVisible ) set.ole.property( pExcel, list( visible=T ) )

# Create a new workbook
pWorkBooks <- get.ole.property( pExcel, "workbooks" )[[1]]
pNewBook <- call.ole.method( pWorkBooks, "Add" )

# Get the 'Styles' collection object for this new workbook
pStyles <- get.ole.property( pNewBook, "Styles" )[[1]]

# Get the total number of styles items for this collection
stylecount <- get.ole.property( pStyles, "Count" )$Count

# Loop through styles...
for(nStyle in 1:stylecount)
{
        # Get the 'Styles' items by calling the 'Item' property
        # of the 'Styles' collection object using call.ole.method()
        # instead of get.ole.property() because get.ole.property()
        # does not allow you to pass arguments to the property.  NOTE:
        # in general this technique works with most servers because
        # properties and methods are not considered to be different.
        pStyle <- call.ole.method( pStyles, "Item", nStyle )
        
        # For this 'Style' get the name and print it out
        sStyleName <- get.ole.property( pStyle, "Name")$Name
        print( sStyleName )
        
        release.ole.object( pStyle )
        rm( sStyleName, pStyle )
}
release.ole.object( pStyles )
release.ole.object( pNewBook )
release.ole.object( pWorkBooks )
release.ole.object( pExcel )
rm( pExcel, ExcelVisible, pWorkBooks, pNewBook, pStyles, stylecount )
# Example S-PLUS code to show how to access the 'Item' property

# of the 'Styles' collection object for an Excel workbook object

# --------------------------------------------------------------

# Written by: Chris Disdero 990911

# Create a new Excel application instance and make it visible

pExcel <- create.ole.object( "excel.application" )

ExcelVisible <- get.ole.property( pExcel, "visible" )$visible

if ( !ExcelVisible ) set.ole.property( pExcel, list( visible=T ) )

# Create a new workbook

pWorkBooks <- get.ole.property( pExcel, "workbooks" )[[1]]

pNewBook <- call.ole.method( pWorkBooks, "Add" )

# Get the 'Styles' collection object for this new workbook

pStyles <- get.ole.property( pNewBook, "Styles" )[[1]]

# Get the total number of styles items for this collection

stylecount <- get.ole.property( pStyles, "Count" )$Count

# Loop through styles...

for(nStyle in 1:stylecount)

{

        # Get the 'Styles' items by calling the 'Item' property

        # of the 'Styles' collection object using call.ole.method()

        # instead of get.ole.property() because get.ole.property()

        # does not allow you to pass arguments to the property.  NOTE:

        # in general this technique works with most servers because

        # properties and methods are not considered to be different.

        pStyle <- call.ole.method( pStyles, "Item", nStyle )

        

        # For this 'Style' get the name and print it out

        sStyleName <- get.ole.property( pStyle, "Name")$Name

        print( sStyleName )

        

        release.ole.object( pStyle )

        rm( sStyleName, pStyle )
}

release.ole.object( pStyles )

release.ole.object( pNewBook )

release.ole.object( pWorkBooks )

release.ole.object( pExcel )

rm( pExcel, ExcelVisible, pWorkBooks, pNewBook, pStyles, stylecount )

