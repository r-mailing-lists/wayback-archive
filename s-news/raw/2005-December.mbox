Here is what the function looks like…

 

 

 

 

 

"ET1" <- function()

 

{

   

   ie1.1 <-punif(runif(1, min=0,
max=1),min=0,max=1) 

 

   

   be1 <- punif(runif(1, min=0,
max=1),min=0,max=1) 

   be2 <- punif(runif(1, min=0,
max=1),min=0,max=1) 

   be3 <- punif(runif(1, min=0,
max=1),min=0,max=1) 

   be4 <- punif(runif(1, min=0,
max=1),min=0,max=1) 

   

   if (ie1.1>.51) ie1.1 <-
0 else ie1.1 <- 1

   

   if (be1>.1) be1 <- 0 else be1 <- 1

   if (be2>.2) be2 <- 0 else be2 <- 1

   if (be3>.3) be3 <- 0 else be3 <- 1

   if (be4>.4) be4 <- 0 else be4 <- 1

   

   

   if (be1==1 && be2==1 ) TE1.1 <- 1 else TE1.1 <-
0

 

   if (be3==1 || be4==1 ) TE1.2 <- 1 else TE1.2 <- 0

       

   if (ie1.1==0) E1<-0

   if (ie1.1==1 && TE1.1==0 && TE1.2==0)
E1<-1

   if (ie1.1==1 && TE1.1==0 && TE1.2==1)
E1<-2

   if (ie1.1==1 && TE1.1==1 && TE1.2==0)
E1<-3

   if (ie1.1==1 && TE1.1==1 && TE1.2==1)
E1<-4

 

   return(E1) 

 

