> 1. did someone written a script given a beautiful unit circle for
> the graphical representation of the initiale variables in the plane
> of the components? 

ellipse <- function(E=diag(2), df.E=1) {
  E.eig <- eigen(E)
  theta <- seq(0, 2*pi, length=101)
  cs <- cbind(cos(theta) / sqrt(E.eig$val[1]/df.E),
              sin(theta) / sqrt(E.eig$val[2]/df.E))
  cs %*% E.eig$vec
}

par(pty="s")
plot(ellipse(), type="l")

