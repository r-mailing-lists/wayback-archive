## Here are two techniques.
##
## cut() generalizes to arbitrary break points.
##
## %/% takes advantage of the use of the 1000s digit as the defining
## characteristic.

x1 <- rep(1:9,3)*1000 + sample(999, 27)

g1 <- cut(x1, breaks=seq(0,10000,1000), left.include=TRUE)-1
g1

x1 %/% 1000

x2 <- c(0, 1, 999, 1000, 1001, 8999, 9000, 9001, 9999)

g2 <- cut(x1, breaks=seq(0,10000,1000), left.include=TRUE)-1
g2

x2 %/% 1000

