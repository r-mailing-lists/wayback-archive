"bdiag"<-
function(x)
{
#  DATE WRITTEN:  2 December 1995             LAST REVISED:  3 December 1995
#  AUTHOR:  Scott Chasalow (sasssc at scri.sari.ac.uk)
#  CURRENT ADDRESS (from 1 Feb 1999): scott.chasalow at cereon.com
#
#  x: a list of matrices (any non-matrix component is coerced to a matrix
via 
#     a call to as.matrix();  in particular,  a vector becomes a column
matrix)
#
# VALUE:  a matrix having the components of x as blocks on the diagonal, 
#         and zero elements elsewhere.
#
# EXAMPLE:  bdiag(list(1, matrix(2:7,2,3),8:10))
#
# SEE ALSO:  kronecker
#
   if(!is.list(x)) stop("x not a list")
   n <- length(x)
   if(n == 0)
      return(NULL)
   x <- lapply(x, function(y)
   if(length(y)) as.matrix(y) else stop("Zero-length component in x"))
   d <- array(unlist(lapply(x, dim)), c(2, n))
   rr <- d[1,  ]
   cc <- d[2,  ]
   rsum <- sum(rr)
   csum <- sum(cc)
   out <- array(0, c(rsum, csum))
   ind <- array(0, c(4, n))
   rcum <- cumsum(rr)
   ccum <- cumsum(cc)
   ind[1, -1] <- rcum[ - n]
   ind[2,  ] <- rcum
   ind[3, -1] <- ccum[ - n]
   ind[4,  ] <- ccum
   imat <- array(1:(rsum * csum), c(rsum, csum))
   iuse <- apply(ind, 2, function(y, imat)
   {
      imat[(y[1] + 1):y[2], (y[3] + 1):y[4]]
   }
   , imat = imat)
   iuse <- as.vector(unlist(iuse))
   out[iuse] <- unlist(x)
   out
}

