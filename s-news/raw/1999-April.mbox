Bob,

Here is a function that does what you want:

"dbind"<-
  function(x)
{
### x is a list of matrices. NULLs and scalars are allowed in the list.
  len.x <- length(x)
  dim.x <- do.call("cbind", lapply(x, function(x)
                                   if (length(x) == 0) 0
                                   else {
                                     if(length(x) == 1) c(1, 1) else dim(x)} ))
  if(any(dim.x[1,  ] != dim.x[2,  ]))
    stop("only square matrices allowed")
  dim.res <- rep(sum(dim.x[1,  ]), 2)
  res <- array(0, dim.res)
  res.ends <- cumsum(dim.x[1,  ])
  res.starts <- c(1, res.ends[ - len.x] + 1)
  for(i in seq(len.x)) if (dim.x[1,i]>0)
    res[res.starts[i]:res.ends[i], res.starts[i]:res.ends[i]] <- x[[i]]
  res
}
