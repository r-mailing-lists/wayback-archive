"DermalExp.S"<-
function(datalist.name, DataSelection, filelength)
{
# Initialize all variables
 datalist.name[["APdataf"]][["InitialExposure"]] <- rep(0, filelength)
 datalist.name[["APdataf"]][["FinalExposure"]] <- rep(0, filelength)
 datalist.name[["APdataf"]][["InitialDose"]] <- rep(0, filelength)
 datalist.name[["APdataf"]][["FinalDose"]] <- rep(0, filelength)
 datalist.name[["APdataf"]][["TCP"]] <- rep(0, filelength)
 datalist.name[["TCP"]] <- rep(0, filelength)
 datalist.name[["APdataf"]][["NondietaryDose"]] <- rep(0, filelength)
 InitialExposure <- rep(0, filelength)
 FinalExposure <- rep(0, filelength)
 InitialDose <- rep(0, filelength)
 FinalDose <- rep(0, filelength)
 TCP <- rep(0, filelength)
 NondietaryDose <- rep(0, filelength)
 temp1 <- 0
 temp2 <- 0
 Ka <- 8.559999999999999e-006
 Ke <- 7.167e-006
 Ki <- 0.0004167
# for every line in subject's activity database, compute exposure and
dose for each contact
 for(i in 1:17280) {
  FinalExpPrev <- temp1
  FinalDosePrev <- temp2
  InitialExposure[i] <- round(switch(datalist.name$APdataf$pathway[i],
   Res.Contact = datalist.name$APdataf$conc[i] * datalist.name$totalSA *
datalist.name$APdataf$
    ContactFrac[i] * datalist.name$APdataf$TE[i] +  FinalExpPrev,
   WaterRemoval = FinalExpPrev * (1 + datalist.name$ APdataf$TE[i] *
datalist.name$APdataf$ContactFrac[i]),
   MouthRemoval = FinalExpPrev * (1 + datalist.name$
    APdataf$TE[i] * datalist.name$APdataf$ContactFrac[i])), 4)
  if(InitialExposure[i] > (MaxLoading.S(datalist.name) *
   datalist.name$totalSA)) InitialExposure[i] <- (
    MaxLoading.S(datalist.name) * datalist.name$
    totalSA) # Compute Final Exposure for line i
  FinalExposure[i] <- InitialExposure[i] - Ka * datalist.name$
   APdataf$duration[i] * InitialExposure[i]
  if(((FinalExpPrev - InitialExposure[i]) > 0) & (datalist.name$
   APdataf$pathway[i] == "MouthRemoval")) NondietaryDose[i
    ] <- (FinalExpPrev - InitialExposure[i]) * 0.7
  InitialDose[i] <- FinalDosePrev # Compute Final Dose for line i
  FinalDose[i] <- InitialDose[i] + Ka * datalist.name$APdataf$
   duration[i] * InitialExposure[i] - Ke * InitialDose[i] *
   datalist.name$APdataf$duration[i] + Ki * NondietaryDose[
   i] * datalist.name$APdataf$duration[i]
  if(FinalDose[i] < 0) FinalDose[i] <- 0
  TCP[i] <- Ke * InitialDose[i] * datalist.name$APdataf$duration[ i]
  temp1 <- FinalExposure[i]
  temp2 <- FinalDose[i]
 }
# Attach the computed columns to subject's database
 datalist.name[["APdataf"]][["InitialExposure"]] <-
round(InitialExposure, 4)
 datalist.name[["APdataf"]][["FinalExposure"]] <- round(FinalExposure,
4)
 datalist.name[["APdataf"]][["InitialDose"]] <- round(InitialDose, 4)
 datalist.name[["APdataf"]][["FinalDose"]] <- round(FinalDose, 4)
 datalist.name[["APdataf"]][["NondietaryDose"]] <- round(NondietaryDose,
4)
 datalist.name[["APdataf"]][["TCP"]] <- round(TCP, 4)
 datalist.name[["TCP"]] <- round(TCP[length(TCP)], 4)
 # return the person's database with all exposure and dose calculations
included
 return(datalist.name)
 options(free = T)
}

