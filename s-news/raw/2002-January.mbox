Hi Mark,

You're doing a reasonable thing, it just doesn't work properly.
For some reason, the controls need to be in a group to get the
desired behavior.

Here's a revised version of your function with groups added:

anybox_function(){
guiCreate("Property", Name = "ModYear", DialogControl = "Check Box",   
          DialogPrompt = "Consider Year", DefaultValue = "T")
guiCreate("Property", Name = "ModMonth", DialogControl = "Check Box",   
          DialogPrompt = "Consider Month", DefaultValue = "T")
guiCreate("Property", Name = "ModArea", DialogControl = "Check Box",   
          DialogPrompt = "Consider Area", DefaultValue = "T")
guiCreate("Property", Name = "ModTC", DialogControl = "Check Box",   
          DialogPrompt = "Consider Tonnage Class", DefaultValue = "T")
guiCreate("Property", Name = "Group1", Type="Group",
        PropertyList=c("ModYear","ModMonth"))
guiCreate("Property", Name = "Group2", Type="Group",
        PropertyList=c("ModArea","ModTC"))      
guiCreate("Property", Name = "Page1", Type="Page", DialogPrompt =
"Tab1",
         PropertyList = c("Group1"))
guiCreate("Property", Name = "Page2", Type="Page", DialogPrompt =
"Tab2",
         PropertyList = c("Group2"))
guiCreate("FunctionInfo", Name="TestTerms",Function= "TestTerms",
         DialogHeader = "Come to Terms",
         PropertyList = "Page1,Page2")
invisible() 
}
anybox()
## Need to define a function for it to work
##  TestTerms <- function(a, b, c, d){}
guiDisplayDialog("Function","TestTerms")

