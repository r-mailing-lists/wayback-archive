Thanks to all who responded.  Prof. Ripley gave excellent help as
usual.  I needed to use mtext.  Here is the code, in case anyone wants
to see how it works:

# first, a function used in the plot
ellipse <- function(R,ratio=0.5,orientation=pi/4,center=c(2,1),N=100){
# R is length of major axis
# ratio is ratio of lengths of minor to major axes
# orientation is angle of major axis relative to horizontal
# center is vector of coordinates of center
# N is number of intervals describing circumference
# unrotated, at origin
x1 <-       R*cos(2*pi*(0:N)/N)
y1 <- ratio*R*sin(2*pi*(0:N)/N)
# rotate and translate
x <- center[1] + cos(orientation)*x1 - sin(orientation)*y1
y <- center[2] + sin(orientation)*x1 + cos(orientation)*y1
return(cbind(x,y))
}

trellis.device(device = postscript, horizontal = F, file = "cost.contours.eps")
par(fty="s") # make figure square
plot(ellipse(2),type="l",bty="l",las=1,
     xlim=c(0,4),ylim=c(-1,3),
     cex=1.5,
     xlab="layer thickness in cell 1",
     ylab=""
)
mtext("layer thickness in cell 2",side=2,line=2.5,cex=1.5)
lines(ellipse(1.5))
lines(ellipse(1.0))
lines(ellipse(0.5))
lines(ellipse(0.005)) # center of ellipses
lines(c(2.5,2.5),c(-1,3),lty=2,lwd=0.1)
lines(c(0,4),c(-1,3),lty=2,lwd=0.1) # regression line
lines(ellipse(0.005,center=c(2.5,1.5)),lwd=2) # minimum along dotted line
dev.off()

