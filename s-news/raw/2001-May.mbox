FORTRAN CODE-----

SUBROUTINE arsim(x,ndim,phi)
!MS$ATTRIBUTES DLLEXPORT :: arsim
INTEGER ndim
REAL x(ndim), phi

IF( ndim .gt. 1)THEN
     DO 10 i=2,ndim
          x(i) = phi*x(i-1)+x(i)
10   CONTINUE
ENDIF
RETURN
END

