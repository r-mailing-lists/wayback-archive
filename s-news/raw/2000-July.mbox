f <- function(dataFrame, prefix) {
        names(dataFrame) <- paste(sep="", prefix, names(dataFrame))
        dataFrame
}
> f(fuel.frame,"FF.")[1:3,]
                FF.Weight FF.Disp. FF.Mileage  FF.Fuel FF.Type 
 Eagle Summit 4      2560       97         33 3.030303   Small
Ford Escort   4      2345      114         33 3.030303   Small
 Ford Festiva 4      1845       81         37 2.702703   Small

You could make it fancier with

f <- function(dataFrame, prefix, suffix) {
        if (!missing(prefix))
                names(dataFrame) <- paste(sep="", prefix, names(dataFrame))
        if (!missing(suffix))
                names(dataFrame) <- paste(sep="", names(dataFrame), suffix)
        dataFrame
}

