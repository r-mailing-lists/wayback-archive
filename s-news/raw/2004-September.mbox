rtnorm <- function(n, mu=0, sigma=1, A=-Inf, B=Inf){
   if(A>B) stop("\n B should be greater than A")
   mu+sigma*qnorm(runif(n, pnorm((A-mu)/sigma), pnorm((B-mu)/sigma)))
}

