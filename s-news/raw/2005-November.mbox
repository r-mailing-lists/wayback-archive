tmp <- c(0,0,12,15,16,0,0,18,4,3,2,0,0)

middle <- function(x) {
  x0 <- (x == 0)
  not0 <- !cumprod(x0) & !rev(cumprod(rev(x0)))
  x[not0]
}

middle(tmp)

