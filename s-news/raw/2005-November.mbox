                     int n= *pn,i,j;
                     double sum=0, sqrsum=0;

                     for (i=0;i<n;i++)
                      {
                          sum += x[i];
                      }
                     *mean = sum/n;
                       for (j=0;j<n;j++)
                      {
                          sqrsum += ((x[j]- *mean)*(x[j]-*mean));
