The following may work:

x <- rnorm(100)
y <- rnorm(100)
z <- runif(100, 0, 5)

plot(x, y, type = 'n')
apply(cbind(x,y,z), 1, function(k) points(k['x'], k['y'], cex=k['z']))

key( x = par('usr')[1], y = par('usr')[3] - par('cxy')[2],
     points = list( pch = c(1, 1, 1), cex=c(1, 3, 5)),
     text   = list( as.character(c(1,3,5) )),
     columns = 3,
     transparent = TRUE)

