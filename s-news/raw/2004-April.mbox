So we use the command "for" and the command "arima.sim". The problem that I have faced is that we can execute the program only for few times and after the execution of the program is failed (results: NA values), I think that there is a problem in memory size allocated for S-plus. We have tried the command "For" but I haven't a good result.

THE PROGRAM : 

  simmtns <-function(p,d,q,n,m,coef)

{c<-matrix(1,m,1)

C<-kronecker(diag(n),t(c))

rmsesnaive<-c()

rmsesls<-c()

rmsesbfl1<-c()

rmsesbfl2<-c()

rmsespoly<-c()

rmsessw<-c()

for (i in 1:1000) {at<-rnorm(100+(m*n),0,1)

at<-at[101:(100+(m*n))]

yt.sim<-arima.sim(m*n,model=list(ar=coef[1:p],ma=coef[(p+1):(p+q)]),innov=at)

Yt.sim<-C%*%yt.sim

ytnaive.sim<-naive(Yt.sim,m,0)

ytls.sim<-Lismansandee(Yt.sim,m)

ytbfl1.sim<-bootfeibeslisman(Yt.sim,1,m)

ytbfl2.sim<-bootfeibeslisman(Yt.sim,2,m)

r<-trunc((p+d+1)+((q-p-d-1)/m))

ytpoly.sim<-polynomiale(Yt.sim,0,m)

rmsesnaive<-c(rmsesnaive, RMSE(yt.sim,ytnaive.sim))

rmsesls<-c(rmsesls, RMSE(yt.sim[(m+1):(m*(n-1))],ytls.sim))

rmsesbfl1<-c(rmsesbfl1, RMSE(yt.sim,ytbfl1.sim))

rmsesbfl2<-c(rmsesbfl2, RMSE(yt.sim,ytbfl2.sim))

rmsespoly<-c(rmsespoly, RMSE(yt.sim[(m+1):(m*n)],ytpoly.sim[(m+1):(m*n)]))}

rmsenaive<-mean(rmsesnaive)

rmsels<-mean(rmsesls)

rmsebfl1<-mean(rmsesbfl1)

rmsebfl2<-mean(rmsesbfl2)

rmsepoly<-mean(rmsespoly)

rmsesw<-mean(rmsessw)

rrmsels<-rmsels/rmsesw

rrmsebfl1<-rmsebfl1/rmsesw

rrmsebfl2<-rmsebfl2/rmsesw

rrmsepoly<-rmsepoly/rmsesw

rrmsenaive<-rmsenaive/rmsesw}

return(rrmsenaive,rrmsels,rrmsebfl1,rrmsebfl2,rrmsepoly)}

simmtns(1,1,1,80,4,c(0.2,0.9))

Thank you in advance

 

		
