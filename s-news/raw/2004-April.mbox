Subject: Re: TR: Specific contrasts in S+
Message-ID: <C8DFDC5896F19C49BC1DD5F2E0F56B380C9322@exqld2-bne.qld.csiro.au>

Dealing with the actual parameterization can get quite tricky. Instead you can 
look at the difference in predictions for the cases dose1batch1time1 - 
dose2batch1time1, etc. If you want standard errors, you need to get at the 
cov.unscaled and sigma components of the fitted object's summary, since 
covariance(beta) = sigma^2 (X'X)^-1. Hopefully the code below is self 
explanatory.

getContrastStatistics <- function(con)
{
#       con is a 1 x n contrast vector typically of the form 
c(...,0,1,0,...,0,-1,0,...)
        xnew <- t(con) %*% mm   # the new X matrix such that xnew %*% beta is 
the predicted contrast
#       t value is predicted value / standard error of prediction
        pred.contrast <- xnew %*% coef(fit)
        sterr <- sqrt(xnew %*% summary(fit)$cov.unscaled %*% t(xnew) * 
summary(fit)$sigma^2)
        tval <- pred.contrast/sterr
        pval <- 2 * (1 - pt(abs(tval), summary(fit)$df[2]))
        c("Predicted contrast" = pred.contrast, "St. error" = sterr, "t-value" 
= tval, "P(>|t|)" = pval)
}
set.seed(222)
df <- expand.grid(dose=factor(1:5),time=factor(1:2),batch=factor(1:3),rep=1:3)
df$y <- rnorm(nrow(df))
contrasts(df$dose) <- contr.treatment(5)
contrasts(df$time) <- contr.treatment(2)
contrasts(df$batch) <- contr.treatment(3)
fit <- lm(y ~ dose * time * batch,df)
mm <- model.matrix(y ~ dose * time * batch, df)
#
#       Can be instructive to look at the model matrix: uncomment next line
#
#image(1-matrix(mm,90,30),xlab="Observations",ylab="Indicator variables")
#
#       Now get predictions of various contrasts and get p-values
#
#       contrast between dose1batch1time1 and dose2batch1time1; 
#       in this parameterization, this is same as dose2 coefficient
df[1:2,]
con <- c(-1,1,rep(0,88)) 
getContrastStatistics(con)
summary(fit)$coef[1:2,]
#
#       contrast between dose1batch1time2 and dose2batch1time2; 
df[6:7,]
con <- c(0,0,0,0,0,-1,1,rep(0,83)) 
#       in this parameterization, this is same as dose2+dose2time coefficients
t(con) %*% mm 
getContrastStatistics(con)
sum(summary(fit)$coef[c("dose2","dose2time"),1])

#
#       Final example: in this parameterization, intercept is same as 
dose1batch1time1 term
#
con <- c(1,0,rep(0,88)) # dose1batch1time1
getContrastStatistics(con)
summary(fit)$coef[1:2,]

rm(df,fit,mm,con,xnew,pred.contrast,sterr,pval,tval)

