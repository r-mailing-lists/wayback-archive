Hi!:
        I have a data frame X as the following:
        Date      Rank1 Rank2           Rank3
    3/1/92         A              B               C
    3/2/92         A             B                C
    3/3/92         B              C               A
I want to summerize how many times A, B or C occured in each column and get
a summary data frame as the following:

           NoteName   Rank1     Rank2           Rank3
                A         2               0               1
                B         1               2               0
                C         0               1               2

I did the following to achieve the above the result, but it is not
neat(especially when I have a dataframe with many columns, are there better
way to do this.  Thanks.

X1 <- as.data.frame(summary.factor(X$Rank1))
Y1 <- as.data.frame(matrix(data=0,nrow=length(names(X1)),ncol=2))
names(Y1) <- c("NoteName","Rank1")
Y1[,1] <- names(X1)
Y1[,2] <-unlist(X1[1,])

X2 <- as.data.frame(summary.factor(X$Rank2))
Y2 <- as.data.frame(matrix(data=0,nrow=length(names(X2)),ncol=2))
names(Y2) <- c("NoteName","Rank2")
Y2[,1] <- names(X2)
Y2[,2] <-unlist(X2[1,])

X3 <- as.data.frame(summary.factor(X$Rank3))
Y3 <- as.data.frame(matrix(data=0,nrow=length(names(X3)),ncol=2))
names(Y3) <- c("NoteName","Rank3")
Y3[,1] <- names(X3)
Y3[,2] <-unlist(X3[1,])

Y <- merger(Y1,Y2)
Y <- merge(Y,Y3)

---Sharon Cavenaugh

