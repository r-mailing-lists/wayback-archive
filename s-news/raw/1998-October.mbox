Date: Tue, 27 Oct 1998 11:59:30 +1100
From: Gordon K Smyth <gks at maths.uq.edu.au>
To: k.mengersen at fsc.qut.edu.au
Subject: S-Plus iteration for GLM

Kerrie,

Here is an S-Plus iteration for fitting a Poisson glm.  On looking at it
again, I'm not sure it will so much use to you - I'm sure you can already
write this sort of stuff yourself.  Anyway, here it is.  (The code actually
simulates a Poisson sequence with a moving average error structure, and
then fits an ordinary Piosson glm.)

# Parameters
K <- 20
n <- 300
p <- 2
beta0 <- 0.693145
beta1 <- 0.005
rho <- 0.4

D <- diag(rep(1,n))
D1 <- (col(D)-row(D))==1
D1 <- D1+t(D1)

# Means
x <- rlnorm(n=K*n,meanlog=3,sdlog=sqrt(0.4))
mu <- exp(beta0+beta1*x)

# Normal image error structure
V <- D + rho*D1
z <- rmvnorm(n=K,cov=V)
y <- qpois(pnorm(z),lambda=mu)

# Fit independence model

glm.y <- glm(y~x,family=poisson)
summary(glm.y)

# Same thing with explicit iteration

X <- cbind(1,x)
mu <- ifelse(y>0,y,0.6)
for (i in 1:5) {
        dmu <- mu*X          % diag(1/g'(mu))*X
        V <- mu              % diag(V(mu))
        Vinv.dmu <- dmu/V
        b <- solve( t(dmu)%*%Vinv.dmu, t(Vinv.dmu)%*%(y-mu+mu*log(mu)) )
                            % last term is y-mu+diag(1/g'(mu))*g(mu)
        mu <- as.vector( exp(X%*%b) )
}
print(b)

