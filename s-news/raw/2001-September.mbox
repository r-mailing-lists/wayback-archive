For cutting at the median of the abs(rnorm(n,0,30)
 
> integrand <- function(x)
{
 mu <- 0
 sd <- 30
 cut <- qnorm(0.75, 0, 30)        
 ifelse(abs(x) <= cut, 0, 1/((2 * pi)^0.5 * sd) * (abs(x) - cut)^2 *
exp( - (x - mu)^2/(2 * sd^2)))
}
> integrate(integrand,-Inf,Inf)[1]
