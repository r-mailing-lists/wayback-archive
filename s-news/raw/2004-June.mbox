# will only work on rpart tree objects

cp.table <- intree$cptable
min.error <- min(cp.table[,4])
one.se <- cp.table[cp.table[,4] == min.error, 5]
cp.range <- cp.table[cp.table[,4] < min.error + one.se, 1]
cp.1se <- max(cp.range)
temp.tree <- prune(intree, cp = cp.1se)
temp.tree
}

## Autoprune with 0 SE rule

prune.0se <- function(intree) {

# Autoprune with 0 SE rule (to lowest error)
# Written by Volker Bahn
# June 6, 2004
# will only work on rpart tree objects

cp.table <- intree$cptable
min.error <- min(cp.table[,4])
cp.0se <- cp.table[cp.table[,4] == min.error, 1]
temp.tree <- prune(intree, cp = cp.0se)
temp.tree
}

