Though far from being parsimonious I'm sure, the following code works:

#Draw m samples, each of size n
gensam <- function(m=1000, n=100, pop)
{
        mem.tally.reset()
        temp <- matrix(,nrow=m*n, ncol=2)
        nr <- nrow(pop)
        a <- 1; b <- n
        for (i in 1:m){
             temp[a:b,] <- pop[ sample(nr, size=n), , drop=F]
             print(mem.tally.report("Generating one sample"))
             a <- a + n; b <- b + n
             }
        on.exit(print(mem.tally.report("Leaving function")))
        dimnames(temp) <- list(NULL, c("x", "y"))
}

