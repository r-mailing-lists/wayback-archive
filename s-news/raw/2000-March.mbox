Many thanks to all who contributed.

>
> "Martin H. H. Stevens" wrote:
>
> > To all:
> > I am currently running a simulation where my summary statistics require
> > I merge (using "merge") pre and post treatment data sets.  I then
> > perform a function by rows in the merged data, and sum the results of
> > the function.
> > The merge function seems really slow.  Is there a faster way to join to
> > datasets "by" a common variable?
>
> Response 1.
> Is your merge a 1-1 merge (i.e., there are no repeated values in the by
> columns
> of x or y)?  If so you can edit merge.data.frame to make a new function,
> which
> I call simple.merge(), with the following patch.
>
>     The !'s are the lines to change and the first part shows the
>     original code and the second the new.  This patch is for Splus5.1's
>     merge.data.frame.  You will be missing the "timeDate" stuff in 4.x's,
>     but it is ok to add it.
>
> *** /tmp/merge.data.frame.old   Mon Mar 20 12:50:25 2000
> --- /tmp/simple.merge.new       Mon Mar 20 12:50:25 2000
> ***************
> *** 50,76 ****
>         }
>         join.index <- function(x, y, augment.x, augment.y)
>         {
> !               if(class(x) == "timeDate")
>                         x = as.character(x)
> !               if(class(y) == "timeDate")
>                         y = as.character(y)
> !               lev <- sort(unique(c(x <- as.vector(x), y <- as.vector(y))))
>
> !               lev.split <- function(x, lev, augment)
> !               {
> !                       val <- split(seq(along = x), factor(x, lev))
> !                       if(augment)
> !                               val <- lapply(val, function(v)
> !                               if(!length(v)) as.integer(NA) else v)
> !                       val
> !               }
> !               xs <- lev.split(x, lev, augment.x)
> !               ys <- lev.split(y, lev, augment.y)
> !               list(x = unlist(lapply(seq(along = lev), function(i, xs, ys)
>
> !               {
> !                       rep(xs[[i]], length(ys[[i]]))
> !               }
> !               , xs, ys)), y = rep(unlist(ys), rep(unlist(lapply(xs,
> length)),
> !                       unlist(lapply(ys, length)))))
>         }
>         by.y <- by.to.int(by.y, y)
>         by.x <- by.to.int(by.x, x)
> --- 50,72 ----
>         }
>         join.index <- function(x, y, augment.x, augment.y)
>         {
> !               if(augment.x || augment.y)
> !                       stop("Cannot use simple.merge with all=T")
> !               x <- as.vector(x)
> !               y <- as.vector(y)
> !               if(any(is.na(x)) || class(x) == "timeDate")
>                         x = as.character(x)
> !               if(any(is.na(y)) || class(y) == "timeDate")
>                         y = as.character(y)
> !               if(any(duplicated(x)))
> !                       stop("Cannot use simple.merge with duplicates in
> x[,by.x]"
> !                               )
> !               if(any(duplicated(y)))
> !                       stop("Cannot use simple.merge with duplicates in
> y[,by.y]"
> !                               )
> !               lev <- sort(intersect(x, y))
> !               list(x = match(lev, x, nomatch = 0), y = match(lev, y,
> nomatch
> !                        = 0))
>         }
>         by.y <- by.to.int(by.y, y)
>         by.x <- by.to.int(by.x, x)
>
