piper.plot <- function(DataSet, xColumn="x", yColumn="y", zColumn="z",
           GraphSheet = "", grid.num=9, title.offset = 0.15,
           label.offset=0.032, digits=2, axis.range=100, GroupColumn=NULL){

           # Rough sketch of function to create Piper plot.

           if (is.character(DataSet))
                     DataSet <- get(DataSet)

           x <- DataSet[,xColumn]
           y <- DataSet[,yColumn]
           z <- DataSet[,zColumn]
           w <- DataSet[,GroupColumn]

           grid.num <- grid.num + 1

           if (!all(length(x)==c(length(y),length(z)))){
                               stop("The x, y, and z columns specified are
of
different lengths.")
           }

           if (length(x) + length(z) + length(z) < 3){
                     stop("One or more of the columns has no data.")
           }

           row.sums <- x+y+z

           if (!all(row.sums==row.sums[1])){
                     stop("The row sums are not all equal.  All rows must
sum
to the same value.")
           }

           axis.range <- axis.range
           # Calculate 2D XY data from 3D triangular data

           graph.y <- x * 0.86602
           graph.x <- z + (graph.y * tan(0.52360))

           axis.center <- axis.range * 0.5
           axis.x.top <- axis.range * 0.5 * 1.73205

           # Triples is defined but not used.  It could be used to label
points.

           triples <- paste("(",x,", ",y,           ", ",z,")",sep="")

           # Set data for axes, grids and ticks

           axis.x <- c(0, axis.range, axis.range * 0.5, 0)
           axis.y <- c(0, 0, axis.range * 0.86602, 0)

           # Labels and titles

           x.title.x <- (axis.range - axis.range*.75) -
title.offset*axis.range
           x.title.y <- axis.range * 0.25 * 1.732050
           x.title.z <- xColumn

           y.title.x <- axis.range * .75 + title.offset*axis.range
           y.title.y <- axis.range * 0.25 * 1.732050
           y.title.z <- yColumn

           z.title.x <- axis.range * 0.5
           z.title.y <- 0 - axis.range*title.offset
           z.title.z <- zColumn

           ## Grids

           # Z axis grid positions

           grid.seq <- (1:grid.num)/grid.num

           z.axis.x <- axis.range * grid.seq
           z.axis.y <- rep(0, grid.num)

           # X and Y axis grid positions

           x.axis.y <- (axis.range * 0.5 * 1.73205) * grid.seq
           y.axis.y <- x.axis.y

           y.axis.x <- (axis.range * 0.5) * grid.seq

           ## The calculation below may need revision.  Check this!!!
           x.axis.x <- axis.range - y.axis.x

           grid.x <- c(rbind(x.axis.x,y.axis.x, NA), rbind(z.axis.x,
y.axis.x, NA),
                     rbind(z.axis.x, c(rev(x.axis.x)[-1], NA), NA))

           # Drop extra NA
           #grid.x <- grid.x[-length(grid.x)]

           grid.y <- c(rbind(x.axis.y, y.axis.y, NA), rbind(z.axis.y,
y.axis.y, NA),
                     rbind(z.axis.y, c(rev(x.axis.y)[-1],NA), NA))

           # Drop extra NA
           #grid.y <- grid.y[-length(grid.y)]

           # Axis labels

           # Remove last row to prevent axis titles from overlapping

           col.length <- length(x.axis.x)
           x.axis.x <- x.axis.x[-col.length]
           x.axis.y <- x.axis.y[-col.length]
           y.axis.x <- y.axis.x[-col.length]
           y.axis.y <- y.axis.y[-col.length]
           z.axis.x <- z.axis.x[-col.length]
           z.axis.y <- z.axis.y[-col.length]

           x.label <- y.label <- z.label <- round(axis.range*grid.seq,
digits)

           y.label <- rev(y.label)
           y.label <- y.label[-1]

           x.axis.x <- x.axis.x + axis.range * label.offset
           y.axis.x <- y.axis.x - axis.range * label.offset
           z.axis.y <- z.axis.y - axis.range * label.offset

           # Start making graph

           if ( !is.null(GraphSheet) && nchar( GraphSheet ) > 0)
                     graph.name <- paste(GraphSheet,"$1",sep="")
           else
                     graph.name <- ""

           guiCreate("Graph2D", Name=graph.name,
                               HorizontalShift = 2,
           VerticalShift = 0.95,
           DisplayWidth = 7,
           DisplayHeight = 7,
           Hide = F,
           xPlotOrigin = 0.7,
           yPlotOrigin = 0.920514,
           Width = 5.0,
           Height = 5.0,
           GraphBorderStyle = "None",
           GraphBorderColor = "Black",
           GraphBorderWeight = "1",
           GraphFillColor = "Transparent",
           GraphFillPattern = "Empty",
           GraphPatternColor = "White",
           AxesBorderStyle = "None",
           AxesBorderColor = "Black",
           AxesBorderWeight = "1",
           AxesFillColor = "Transparent",
           AxesFillPattern = "Empty",
           AxesPatternColor = "White")

           gsName <- guiGetCurrMetaDoc( "GraphSheet")
           guiModify( "GraphSheet", Name = gsName, SetRedraw = F)

           graph.name <- paste(gsName,"$1",sep="")

           axis.name <- paste(graph.name, "$Axis2dX1",sep="")

           guiCreate("Axis2dX", Name=axis.name, Weight ="1/4",
                     AxisMin=axis.range, AxisMax="0", MajorTickLength
= "0",
                     DrawFrame="None")

           title.name <- paste(axis.name, "$Axis2DLabelX", sep="")

           guiCreate( "Axis2DLabelX", Name = title.name,
                     LabelType = "None")

           axis.name <- paste(graph.name, "$Axis2dY1",sep="")

           guiCreate("Axis2dY", Name=axis.name, Weight="1",
                     Hide=T, AxisMin="0", AxisMax=axis.range)

           title.name <- paste(graph.name, "$Axis2dX1$1",sep="")

           guiCreate("XAxisTitle", Name=title.name, Hide=T)

           title.name <- paste(graph.name, "$Axis2dY1$1",sep="")

           guiCreate("YAxisTitle", Name=title.name, Hide=T)

           # Create line plots for axes and grids

           plot.name <- paste(graph.name, "$Axes",sep="")

           guiCreate("LinePlot", Name=plot.name,
                     LineStyle = "Solid",
                     LineColor = "Black",
                     LineWeight = "1/2",
                     SymbolFreq = 0,
                     xValues = axis.x,
                     yValues = axis.y)

           plot.name <- paste(graph.name, "$Grids", sep="")

           guiCreate("LinePlot", Name=plot.name,
                     PlotNumber = 1,
                     xValues = grid.x,
                     yValues = grid.y,
                     LineStyle = "Solid",
                     LineColor = "Black",
                     LineWeight = "Hairline",
                     BreakForMissings = T,
                     SymbolFreq = 0)

           # Make comment plots for axis titles and labels

           title.name <- paste(graph.name, "$zAxisTitle", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = z.title.x,
                     yValues = z.title.y,
                     zValues = z.title.z,
                     HorizJustif = "Center",
                     VerticalJustif = "Center",
                     FillColor = "Transparent",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 18,
                     FontColor = "Black",
                     Angle = 0,
                     Crop = F)

           title.name <- paste(graph.name, "$xAxisTitle", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = x.title.x,
                     yValues = x.title.y,
                     zValues = x.title.z,
                     HorizJustif = "Center",
                     VerticalJustif = "Center",
                     FillColor = "Transparent",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 18,
                     FontColor = "Black",
                     Angle = 300)

           title.name <- paste(graph.name, "$yAxisTitle", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = y.title.x,
                     yValues = y.title.y,
                     zValues = y.title.z,
                     HorizJustif = "Center",
                     VerticalJustif = "Center",
                     FillColor = "Transparent",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 18,
                     FontColor = "Black",
                     Angle = 60)

           title.name <- paste(graph.name, "$xAxisLabels", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = y.axis.x[c(2,4,6,8)],
                     yValues = x.axis.y[c(2,4,6,8)],
                     zValues = x.label[c(2,4,6,8)],
                     HorizJustif = "Right",
                     VerticalJustif = "Center",
                     LabelFormat = "Auto",
                     FillColor = "Transparent",
                     FillPattern = "Empty",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 12,
                     FontColor = "Black",
                     Angle = 0,
                     Crop = F)

           title.name <- paste(graph.name, "$yAxisLabels", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = x.axis.x[c(2,4,6,8)],
                     yValues = y.axis.y[c(2,4,6,8)],
                     zValues = y.label[c(2,4,6,8)],
                     HorizJustif = "Left",
                     VerticalJustif = "Center",
                     LabelFormat = "Auto",
                     FillColor = "Transparent",
                     FillPattern = "Empty",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 12,
                     FontColor = "Black",
                     Angle = 0,
                     Crop = F)

           title.name <- paste(graph.name, "$zAxisLabels", sep="")

           guiCreate("CommentPlot", Name=title.name,
                     PlotNumber =1,
                     UseAxesUnits = T,
                     xValues = z.axis.x[c(2,4,6,8)],
                     yValues = z.axis.y[c(2,4,6,8)],
                     zValues = z.label[c(2,4,6,8)],
                     HorizJustif = "Center",
                     VerticalJustif = "Center",
                     LabelFormat = "Auto",
                     FillColor = "Transparent",
                     FillPattern = "Empty",
                     BorderStyle = "None",
                     Font = "Arial",
                     FontSize = 12,
                     FontColor = "Black",
                     Angle = 0,
                     Crop = F)

# Create actual plot

           plot.name <- paste(graph.name, "$Plot", sep="")

           guiCreate("LinePlot", Name=plot.name,
                     LineStyle = "None",
                     SymbolStyle = "Circle, Solid",
                     SymbolColor = "Blue",
                     SymbolHeight = 0.15,
                     SymbolLineWeight = "1/2",
                     SymbolFreq = 1,
                     xValues = graph.x,
                     yValues = graph.y,
                     wValues = w)

# Vary symbol type

           guiModify( "LinePlot", Name = plot.name,
                     VarySymbolStyleType = "w Column")
           guiModify( "GraphSheet", Name = gsName, SetRedraw = T)

           invisible(graph.name)

}

