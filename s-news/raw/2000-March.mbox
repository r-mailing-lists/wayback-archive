Since the question was asked publicly, I'll reply publicly:

For the function revise() to work, S-PLUS 2000 requires the following
revision of the function data.ed:

"data.ed"<-
function(values)
{
        if(!is.sgui.app())
                stop("data.ed not available in this application")
        values.name <- substitute(values)
        if(sys.parent() == 1 && is.name(values.name)) {
                values.name <- as.character(values.name)
                temp.values <- F
        }
        else {
                values.name <- ".temp.data.ed"
                assign(values.name, values, where = 1)
                temp.values <- T
        }
        values.file <- paste(values.name, ".sdd", sep = "")
        data.dump(values.name, values.file)
        on.exit(unlink(values.file))
        if(temp.values) {
# next two do a 'remove(..., immediate=T)'
# to avoid 'Overwrite?' dialog
                remove(values.name, where = 1)
                synchronize(1)
        }
        system(paste("gui:DataEditor", values.file))
        values.exists <- exists(values.name, where = 1)
        ret <- if(values.exists) get(values.name, where = 1) else NULL
        if(temp.values && values.exists)
                remove(values.name, where = 1)
        invisible(ret)
}

You should save this function in a script file and run it to create a local
copy of data.ed.  revise() should now work.

