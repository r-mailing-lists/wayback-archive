Thank you Prof Ripley.

The edited aggregate.data.frame function, Agg, works as expected.
Original post appended.

### Solution:
> Agg <- aggregate.data.frame

                # aggregate.data.frame lines 39-46
                val <- lapply(x, function(xi, all.indices, fun)
                {
                        val <- lapply(split(xi, all.indices), FUN = fun)
                        # if(any(unlist(lapply(val, function(x)
length(x) != 1)))) stop("FUN did not always return a scalar")
                        if(length(unlist(val, recursive = F)) !=
length(val)) stop("FUN did not always return a scalar")
                        unlist(val)
                }
                , all.indices = all.indices, fun = FUN)

                # Agg lines 39-46
                val <- lapply(x, function(xi, all.indices, fun, ...)
                {
                        val <- lapply(split(xi, all.indices), FUN = fun,
...)
                        # if(any(unlist(lapply(val, function(x)
length(x) != 1)))) stop("FUN did not always return a scalar")
                        if(length(unlist(val, recursive = F)) !=
length(val)) stop("FUN did not always return a scalar")
                        unlist(val)
                }
                , all.indices = all.indices, fun = FUN, ...)

The following commands now produce identical results:

> outm <- aggregate(Morph[,8:24], Morph[,1:3], Mean)
> outv <- aggregate(Morph[,8:24], Morph[,1:3], Var)
> outn <- aggregate(Morph[,8:24], Morph[,1:3], N)

> outmA <- Agg(Morph[,8:24], Morph[,1:3], mean, na.rm=T)
> outvA <- Agg(Morph[,8:24], Morph[,1:3], var, na.method="available")
> outnA <- Agg(Morph[,8:24], Morph[,1:3],
function(x)length(x[!is.na(x)]))

