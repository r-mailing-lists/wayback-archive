## It is an interesting exercise.  Yes, it is easy to program.
## But it is a very complex thing you are asking for.
## Does it really make sense?
##
## Rich

evens <- function(x) {
  xo <- order(x)
  xs <- x[xo]
  names(xs) <- xo
  
  dxsr <- diff(xs)
  d5r <- (dxsr > .05)*1    ## the "*1" is needed due to a bug (see below)
  right.gt.05 <- (rev(cumprod(rev(d5r))) == 1) ## keep names
  rnames <- as.numeric(names(right.gt.05)[right.gt.05])
  
  dxsl <- rev(diff(rev(-xs)))
  d5l <- (dxsl > .05)*1    ## the "*1" is needed due to a bug (see below)
  left.gt.05 <- (cumprod(d5l) == 1) ## keep names
  lnames <- as.numeric(names(left.gt.05)[left.gt.05])
   
  keep <- (!c(F, right.gt.05)) & (!c(left.gt.05, F))
  names(keep)[1] <- xo[1]
  range.x <-
    if (sum(keep) >= 4)
      diff(range(xs[keep]))
    else
      NA

  y <- x
  y[c(lnames,rnames)] <- NA
  c(y, range=range.x)
}

x <- rnorm(10)
x
evens(x)

