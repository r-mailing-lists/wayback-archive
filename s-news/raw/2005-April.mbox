Message-ID: <d073c6a5.e8089cf9.8201000@po-d.temple.edu>

base and baseinv are the functions you need. These functions
map the bits into numbers and are therefore highly inefficient for
the task you describe.  Doing it efficiently would require you to write
a set of C subroutines and then access them through the .C() function.

This set of functions and examples use them are designed for the pedagogical
purpose of explaining mixed-radix arithmetic.  Efficiency is therefore not
worried about.

A loop of the form you suggest would be highly inefficient in the S language.
Rich

## c:/HOME/rmh/581.f04/0902/base-revised.s
base.0 <- function(x, basis=c(2,2,2,2,2,2,2,2)) {
  cb <- cumprod(c(1,basis))
  xx <- x
  y <- rep(0, length(cb))  
  for (i in length(cb):1) {
    yy <- xx %/% cb[i]
    if (yy > 0) {
      y[i] <- yy
      xx <- xx %% cb[i]
    }
  }
  names(y) <- cb
  y
}

baseinv <- function(y, basis=c(2,2,2,2,2,2,2,2)) {
  sum(y * cumprod(c(1,basis)))
}

base.0(200)
baseinv(.Last.value)

### do this manually:
## trace(base.0, exit=browser)
base.0(200)
## untrace()
### end manually

## British money
base.0(498, c(12,20))
rev(base.0(498, c(12,20)))

## American weight
base.0(100, 16)

## binary arithmetic with 8 bits

basis <- c(2,2,2,2,2,2,2,2)
x <- 100

y <- base.0(x, basis)
y
baseinv(y, basis)

base.0(1)
baseinv(.Last.value)

base.0(200)
baseinv(.Last.value)

base.0(1000)
baseinv(.Last.value)

base <- function(x, basis=c(2,2,2,2,2,2,2,2),
                 trace.steps=F, overflow.truncate=T) {
  cb <- cumprod(c(1,basis))
  xx <- x
  y <- rep(0, length(cb))  
  for (i in length(cb):1) {
    yy <- xx %/% cb[i]
    if (yy > 0) {
      y[i] <- yy
      xx <- xx %% cb[i]
    }
    if (trace.steps) {
      if (i==length(cb)) cat("x", x, "\n")
      cat("xx", xx, "yy", yy, "position", cb[i], ", y", y, "\n")
    }
    if (overflow.truncate && (i==length(cb)) && (y[i] > 1)) {
      y[length(cb)] <- 1
      if (trace.steps)
        cat("xx", xx, "yy", yy, "position", cb[length(cb)], ", y", y, "\n")
    }
  }
  names(y) <- cb
  y
}

basis <- c(2,2,2,2,2,2,2,2)
x <- 100

y <- base(x, basis)
y
baseinv(y, basis)

base(1)
baseinv(.Last.value)

base(200)
baseinv(.Last.value)

base(1000)
baseinv(.Last.value)

base(1000, trace=T)
baseinv(.Last.value)

base(1000, trace=T, overflow.truncate=F)
baseinv(.Last.value)

base(1000, overflow.truncate=F)
baseinv(.Last.value)

