"gen.cycle" <- 

function(x)

{

            x <- x + 1

            t(apply(cbind(x, cumprod(x),
rev(cumprod(rev(x)))), 1, function(x)

            {

                        rep(rep(1:x[1],
each = x[2]/x[1]), x[3]/x[1])

            }

            ) - 1)

}

 

make.perm<-function(n,values=n)

{

  w<-gen.cycle((n-1):0)+1

  ww<-apply(w,2,function(x,n1,values)

            {

              start<-n1

              for(i in n1)

                {

                  x[i]<-start[x[i]]

                 
start<-start[start!=x[i]]

                }

              values[x]

           
},n1=1:n,values=values)

  t(ww)

}

 

