                unlist(lapply(upper, function(upper, integrand)
                {
                         integrate(f = integrand,
                                  lower = 0,
                                  upper = upper, tt=upper)$integral
                }
                , integrand))

        }
        return(integrate(f = fun,
                         lower = 1,
                         upper = 5,
                         integrand = function(x,tt) {2*(tt^2)*exp(-x*tt)}
                )$integral)
}
25-1+exp(-25)-exp(-1) # exact value
