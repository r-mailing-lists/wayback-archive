Response of David Parkhurst:

This function worked the last I tried 
it.  I hope it is well enough 
documented.  It

allows plotting more than one variable, 
in vertically stacked plots.

Dave Parkhurst

  dp.dotplot <- function( 
x, 

  nbins=rep( 80,nrow(x) ),  

  del.y=rep( 1, nrow(x) ),  

  y.spacing.factor=rep( 3,nrow(x) 
),       

  ... ) {#

         # 
x is a matrix, with each row a dataset          

         # 
number of "histogram" bins

         # 
Vertical spacing of points in the bins

         # 
Multiplier of del.y for space between vectors.

  nr _ nrow(x);  nc _ ncol(x)

  # Create TF matrix for NAs  (Is this really needed??)

  xNotNA _ x

  xNotNA _ matrix(!is.na(as.numeric(x)),nrow=nr)

  #print(x)

  #print(xNotNA)

  # Dimension two arrays to be 
used for adjusted plot data

  xx _ array(rep(0,nr*nc),c(nr,nc))

  yy _ array(rep(0,nr*nc),c(nr,nc))

#print("Just before start of 
loop 1")

# Next part seems to assume there 
are some positive numbers

  for (i in 1:nr) { # Step through 
rows to set up plot data     #1

                    # 
For now, ignore y offset for each group

    m _ min(as.numeric(x[i,]), 
na.rm=T)*0.999999   

    M _ max(as.numeric(x[i,]), 
na.rm=T)

 if (m==0) m_-0.05*M        ##### 
Experimenting (2/22/01)---worked

    delta _ (M-m) / 
nbins[i]

    bin.n _ rep(0, 
nbins[i])

    done _ rep(0,nc)

    for (k in 1:nbins[i]) 
{ #2

      bot 
<- m + (k-1)*delta

      top 
<- bot + delta

      for 
(j in 1:nc) { #3

        if 
(!xNotNA[i,j]) {done[j]_1; xx[i,j]_"NA"; yy[i,j]_"NA" }

        if 
(done[j] == 0) { #4

          if 
(x[i,j] > bot && x[i,j] <= top) { #5

            xx[i,j] 
<- m + (k-0.5) * delta

            bin.n[k] 
<- bin.n[k] + del.y[i]

            yy[i,j] 
<- bin.n[k]

            done[j] 
<- 1

} #5            

} #4

} #3

} #2

} #1

#print("Past } #1")

#print(y.spacing.factor)#

print(del.y)

  # Now add offsets to the yy 
values for each group except the first

  for (i in 2:nr) { #6

    offset _ max(as.numeric(yy[i-1,]),na.rm=T)+y.spacing.factor[i]* 
del.y[i]

#print("offset  ",offset)                                            

    for (j in 1:nc) 
if (!is.na(yy[i,j]))  

                       yy[i,j] 
_ as.numeric(yy[i,j]) + offset                     

} #6  

#print("Past } #6")

#  # Copy xx and yy to vectors, 
omitting na's

   xxx _ as.vector(as.numeric(xx[xNotNA]) 
)

   yyy _ as.vector(as.numeric(yy[xNotNA]))

################################### 
DEBUG

#   print(xx[xNotNA])

#   print(xxx)

  # Plot the pseudo-points, skipping 
na's

  plot(xxx, yyy, xlab="", 

       yaxt="n", 
ylab="",...)   # 

} # end of dotplot function

