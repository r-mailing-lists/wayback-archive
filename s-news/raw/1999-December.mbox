between two curves (which you can use with the bottom curve ylow=
rep(0,length(yhi)) ) :

confshade <- function(x,ylo,yhi,col=8) {
#
# Draw a [Shade]d [Conf]idence band.
#

  n <- length(x)
  for (i in 1:(n-1)) {
    polygon(c(x[i],x[i+1],x[i+1],x[i]),c(ylo[i],ylo[i+1],yhi[i+1],yhi[i]),
      col=col,border=F)
  }
