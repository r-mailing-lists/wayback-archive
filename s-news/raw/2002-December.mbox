Yesterday I asked for any insights on the failure of mcnemar.test to resolve
situations in which either of x or y has levels not obtained for the other.
Pete Meyer responded that I might modify the original function to eliminate
zero-denominator pairs and reduce the degrees of freedom accordingly. So,
very tentatively, I made the following revisions (just the 3 lines bounded
by comments) to mcnemar.test (calling it mcnx.test):

        .
        .
        .
        storage.mode(cr.cl) <- "double"
        t.cr.cl <- t(cr.cl)
        upper.triang <- row(cr.cl) < col(cr.cl)
        dif <- cr.cl[upper.triang] - t.cr.cl[upper.triang]
        correct <- as.logical(correct) && (r == 2) && (abs(dif) >= 1)
        nums <- if(r == 2) (abs(dif) - ifelse(correct, 1, 0))^2 else dif^2
        denoms <- cr.cl[upper.triang] + t.cr.cl[upper.triang]
        #Revision M Fowler Dec 11 2002
        #Eliminating nums, denoms pairs where denom equal zero
        #Reducing the degrees of freedom by 1 per eliminated pair
        nums <- nums[denoms != 0]
        r <- r - (length(denoms) - length(nums))
        denoms <- denoms[denoms != 0]
        #End of revision
        if(any(denoms == 0)) warning(
                        "Sums of some counts [i,j] + [j,i] are zero.
Statistic undefined."
                        )
        ret.val <- list(statistic = sum(nums/denoms), parameters = (r * (r -
1))/
                2, method = if(correct) 
                        "McNemar's chi-square test with continuity
correction"
                 else "McNemar's chi-square test without continuity
correction",
                data.name = if(is.matrix(x)) deparse(substitute(x)) else
paste(
                        deparse(substitute(x)), " and ",
deparse(substitute(y)),
                        sep = ""))
        .
        .
        .

