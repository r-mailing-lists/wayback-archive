   Let me summarize what I learned on spline interpolation
using S-Plus.

function()
{
        xx <- c(1, 2, 3, 4, 5)
        yy <- c(2, 5, 4, 5, 3)
        data1 <- data.frame(x = xx, y = yy)
        fit.lm <- lm(y ~ bs(x, knots = c(3.5), degree = 3), data = data1)
        ex <- seq(from = 1, to = 5, by = 0.1)
        data2 <- data.frame(x = ex)
        ey <- predict(fit.lm, newdata = data2, type = "response")
