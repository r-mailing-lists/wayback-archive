   new.data <- data.frame(time=time,vl=vl,v0=vl[1], E, CL, t0, lamda1, lamda2, A)

   param(new.data,"Delta") <- 0.05 

Deltafit <-  nls(vl ~ V0*( A*exp(-lamda1*(time - t0)) + (1-A)*exp( - lamda2*(time-t0))), data="" trace=T)

