data$x[is.na(data$x)==F]; data$x<- rep(x, times=x1$lengths)

### peter (problem when first value missing -> instead of keeping na falsely
lags down previous case)
fill2 <- function(my.data)
{
# my.data is a numeric or factor variate which gives an id for the first
# value of plot or tree.id or whatever (otherwise it is missing or blank),
# and there are varying numbers of subplots per plot or whatever.  This
# function fills in the missing or blank values with the appropriate id.
#    Peter Alspach 11 August 1999 (modified 24 May 2001)
  l1 <- length(my.data)
  if (is.factor(my.data)==T)
  {
    rep(my.data[my.data!=''], diff(c((1:l1)[my.data!=''], (l1+1))))
  }
  else
  {
    rep(my.data[!is.na(my.data)], diff(c((1:l1)[!is.na(my.data)], (l1+1))))
  }
}

data$x <- fill2(data$x)

