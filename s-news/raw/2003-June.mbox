fill <- function(x) {
      # fill in a vector of values
      # assign to every NA or "" the last value for the vector
      y <- x
      last <- x[1.]
      if(is.character(x)) {
            for(i in 2.:length(x))
                  if(x[i] == "") y[i] <- last else last <- x[i]
      }
      else {
            for(i in 2.:length(x))
                  if(is.na(x[i])) y[i] <- last else last <- x[i]
      }
      y
}
