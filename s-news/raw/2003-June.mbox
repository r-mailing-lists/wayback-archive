Is this what you need?

dat <- data.frame(Dn = c(1, 1, 1, 2, 2, 2),
                  R1 = c(1, 0, 3, 5, 6, 4))
by(dat$R1, dat$Dn, function(x) {
  m <- min(x)
  c(m, which(x == m))
})

