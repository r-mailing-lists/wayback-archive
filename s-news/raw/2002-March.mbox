Format = "", TargetStartCol
                                         = "1", DataFrame = paste("path", k,
"frame", i, "page", j, sep = ""), NameRow = NameRow[[k]][[i]][j], StartCol =

                                        "1", EndCol = "END", StartRow =
StartRow[[k]][[i]][j], EndRow = "END", Delimiters = ", \\t", 
                                        SeparateDelimiters = F, PageNumber =
as.character(j), RowNameCol = "", StringsAsFactors = "Never", 
                                        VLabelAsNumber = F, DatesAsDoubles =
F, Filter = "", OdbcConnection = "", OdbcSqlQuery = "")
                                

                                        guiClose("data.frame", paste("path",
