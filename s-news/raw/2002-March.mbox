bblik<- function(param,dd,y,nn){
mu <- 1 - exp(-param[1]-param[2]*dd-param[3]*dd^2)
dose <- sort(unique(dd))
counts <- rep(0,length(dose))
for(i in 1:length(dose)){
counts[i] <- sum(dd==dose[i])
}
phi <- rep(param[4:length(param)],counts)
elements <- rep(0,length(dd))
for(i in 1:length(dd)){
if(y[i]>0){
        k <- 0:(y[i]-1)
        elements[i] <- sum(log(k*phi[i] + mu[i]))
}
if(nn[i]>y[i]){
        k <- 0:(nn[i]-y[i]-1)
        elements[i] <- elements[i] + sum(log(k*phi[i] -
mu[i]+1))
}
if(nn[i]>0){
        k <- 0:(nn[i]-1)
        elements[i] <- elements[i] - sum(log(k*phi[i]+1))
}
}
return(-sum(elements))
############################################################

bblik.g<-function (param,dd,y,nn){
mu <- 1 - exp(-param[1]-param[2]*dd-param[3]*dd^2)
exp.eta<- 1-mu
dose <- sort(unique(dd))
mudose<-  1 - exp(-param[1]-param[2]*dose-param[3]*(dose^2))
eta.dose<- 1-mudose
g.element<-rep(0,length(param))
counts <- rep(0,length(dose))
for(i in 1:length(dose)){
counts[i] <- sum(dd==dose[i])
}
for(i in 1:length(dose)){
phi <- rep(param[4:length(param)],counts)
}
phiu<-rep(0,length(dose))
for (i in 1: length(dose)){
phiu[i]<-param[3+i]
}
for(i in 1:length(dd)){
if(y[i]>0){
  k <- 0:(y[i]-1)
g.element[1]<- g.element[1] + sum(exp.eta[i]/(k*phi[i] + mu[i]))
g.element[2]<- g.element[2] + sum(dd[i]*exp.eta[i]/(k*phi[i] + mu[i]))
g.element[3]<- g.element[3] + sum((dd[i])^2*exp.eta[i]/(k*phi[i] + mu[i]))

}
if(nn[i]>y[i]){
  k <- 0:(nn[i]-y[i]-1)
g.element[1]<- g.element[1] -  sum(exp.eta[i]/(k*phi[i]+exp.eta[i]))
g.element[2]<- g.element[2] -  sum(dd[i]*exp.eta[i]/(k*phi[i]+exp.eta[i]))
g.element[3]<- g.element[3] -
sum((dd[i])^2*exp.eta[i]/(k*phi[i]+exp.eta[i]))
}
}
for(j in 1:length(dose)){
yd<-y[dose[j]==dd]
nd<-nn[dose[j]==dd]

for (i in 1:counts[j]){

if(yd[i]>0){
  k <- 0:(yd[i]-1)
g.element[j+3]<- g.element[j+3]+ sum(k/(k*phiu[j]+ mudose[j]))
}
if(nd[i]>yd[i]){
  k <- 0:(nd[i]-yd[i]-1)
  g.element[j+3]<- g.element[j+3]+sum(k/(k*phiu[j]+ eta.dose[j]))
}
if(nd[i]>0){
k <- 0:(nd[i]-1)
  g.element[j+3]<-g.element[j+3]-sum(k/(k*phiu[j]+1))

}
}
}
return(-g.element)
}
#################################################################

