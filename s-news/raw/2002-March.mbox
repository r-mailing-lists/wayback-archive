perfect but gives some freedom. I cannot recall but the remove part is not
working as I expected but code should work without it as well. Feel free to
use it:

        for(k in 1:length(DataSourcePaths)) {
                for(i in 1:length(DataSourceFiles)) {
                        for(j in Pages.InFiles[[k]][[i]]) {
                                nrPages <- nrPages + 1
        
silent.eval(remove(list=as.character(paste("path", k, "frame", i, "page", j,
sep = ""))))
cat(paste("Importing data from:", paste(DataSourcePaths[k], "\\",
as.name(DataSourceFiles[i]), "/page", as.character(j), sep = "")), fill =
