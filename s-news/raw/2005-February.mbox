Hallo Annaële,

Here a function:

"AUC"<-
function(time, y, na.rm = T)
{
        if(na.rm == T) {
                sel.1 <- !is.na(time)
                sel.2 <- !is.na(y)
                sel <- sel.1 * sel.2
                tt <- time[sel == 1]
                yy <- y[sel == 1]
                xxx <- sum((sort(tt) - tt)^2)
                if(xxx != 0)
                        stop("Time points must be sorted in ascending order!")
        }
        else {
                tt <- time
                yy <- y
                xxx <- sum((sort(tt) - tt)^2)
                if(xxx != 0)
                        stop("Time points must be sorted in ascending order!")
        }
        n <- length(tt)
        AUC <- sum((yy[-1] + yy[ - n]) * (tt[-1] - tt[ - n]))/2
        class(AUC) <- "AUC"
        AUC
}

Bonne chance,
Paul

