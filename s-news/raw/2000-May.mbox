No but the problem is mildly fascinating.  Here is a first cut:

perm <- function(set) {
        if((n <- length(set)) <= 1)
                return(set)
        nfact1 <- prod(1:(n - 1))
        nfact <- nfact1 * n
        X <- matrix(rep(set, rep(nfact1, n)), nfact, n)
        m2 <- 0
        for(i in 1:n) {
                m1 <- m2 + 1
                m2 <- m2 + nfact1
                X[m1:m2, 2:n] <- Recall(set[ - i])
        }
        X
}

Quick check:

perm(letters[1:3])
     [,1] [,2] [,3] 
[1,] "a"  "b"  "c" 
[2,] "a"  "c"  "b" 
[3,] "b"  "a"  "c" 
[4,] "b"  "c"  "a" 
[5,] "c"  "a"  "b" 
[6,] "c"  "b"  "a" 

> perm(1:4)
      [,1] [,2] [,3] [,4] 
 [1,]    1    2    3    4
 [2,]    1    2    4    3
 [3,]    1    3    2    4
 ....
[23,]    4    3    1    2
[24,]    4    3    2    1
> 

Looks OK.
