{print(match.call())

Fi*exp(-M*(tc-tr))*exp(-(Fi+M)*(x-tc))*a*(Linf*(1-exp(-kk*(x/12-.04167-t0+cc/2/pi*sin(2*pi*(x/12-.04167-ts))))))^b

}

integrate(integrand,lower=tc,upper=tm,
Linf=Linf,kk=k,t0=t0,cc=cc,ts=ts,Fi=Fi,M=M,tc=tc,tr=tr,tm=tm,a=a,b=b)$integral

}

 

