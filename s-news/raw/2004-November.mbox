tmp.mv=matrix(c(0,0,3,3,3,0,0,4),nrow=nrow(x), ncol=ncol(x), byrow=T)
tmp.m=data.frame(1/(sapply(x[,1:8], FUN=as.numeric)!=tmp.mv))
