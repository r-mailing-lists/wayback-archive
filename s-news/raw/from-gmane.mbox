TRY THIS:
-----
date.char <- c('20040102', '20040105', '20040106', '20040107', '20040108',
   '20040109')
timeDate(
  date.char,
  in.format = "%04Y%02m%02d",
  format    = "%04Y/%02m/%02d"
)
[1] 2004/01/02 2004/01/05 2004/01/06 2004/01/07 2004/01/08 2004/01/09
