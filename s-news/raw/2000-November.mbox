myfun <- function()
{
 set.seed(1)
 assign("x", arima.sim(n = 100, model = list(ar = 0.9)), frame = 1)
 model.1 <- lm(x[3:100] ~ x[2:99])
 model.2 <- lm(x[3:100] ~ x[2:99] + x[1:98])
 BIC(model.1, model.2)
}

