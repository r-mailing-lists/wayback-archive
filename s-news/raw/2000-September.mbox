**** Thomas Jagger ****

Tim and all, here is a vectorized version. of the Hammersley, so that you 
can have the multiple dimensions returned in a matrix form.

"hammersley"<-
function(m, b)
{
b <- as.integer(b)
m <- as.integer(m)
maxdiv <- ceiling(log(max(m) + 1)/log(b))
lb <- length(b)
lm <- length(m)
smax <- sum(maxdiv)
ham <- rep(m, smax)
pos <- rep(((1:smax) - 1) - rep(c(0, cumsum(maxdiv[ - lb])), maxdiv),
rep(lm, smax))
bb <- rep(rep(b, maxdiv), rep(lm, smax))
ham <- ((ham %/% (bb^pos)) %% bb)/(bb^(pos + 1)) dim(ham) <- c(lm, smax)
maxpat <- as.vector(rbind(maxdiv, c(rep(smax, lb - 1), 0))) mat <- 
rep(rep(c(1, 0), lb), c(maxpat))
dim(mat) <- c(smax, lb)
ham <- ham %*% mat
dimnames(ham) <- list(NULL, paste(b)) ham
}
