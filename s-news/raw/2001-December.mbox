testdata$k<-rep(log(c(50,100,300)), each=120)

testdata$y<-dens.func(testdata$N, testdata$a, 
testdata$b,testdata$k)+testdata$site.eff+testdata$err

model<-nlme(y~dens.func(N,a,b,k), fixed=list(a~-1+Sex,b~-1+N,k~-1+Habitat), 
random=a+b+k~1|Site, data=testdata, 
start=c(30,45,0.001,log(c(50,100,300))), control=list(msMaxIter=100), 
