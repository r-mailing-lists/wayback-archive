> "binom.CI"<-
> function(x, n, level = 0.95, eps = 0.00001, max.iter = 100)
> {
>         a <- (1 - level)/2
>         # find upper endpoint of CI
>         if(x == n) P.max <- 1
>         else
>         {
>         OP <- (x+.5)/(n+1)
>         P0 <- OP + 1.8 * sqrt(OP * (1 - OP))/sqrt(n)
>         P1 <- OP + 1.9 * sqrt(OP * (1 - OP))/sqrt(n)
>         if(P0 >= 1)
>                 P0 <- 0.98
>         if(P1 >= 1)
>                 P1 <- (P0 + 1)/2
>         done <- 0
>         iter <- 0
>            while(!done) {
>                 Y0 <- pbinom(x, n, P0)
>                 Y1 <- pbinom(x, n, P1)
>                 slope <- (Y1 - Y0)/(P1 - P0)
>                 step <- (a - Y0)/slope
>                 P <- P1
>                 P1 <- P0 + step
>                 if(P1 >= 1)
>                         P1 <- 0.99999000000000005
>                 if(P1 <= 0)
>                         P1 <- 9.9999999999999995e-07
>                 P0 <- P
>                 if(abs(P0 - P1)/P1 < eps)
>                         done <- 1
>                 iter <- iter + 1
>                 if(iter > max.iter)
>                         {
>                         done <- 1
>                         cat("P.max failed to converge after", iter,
>                                 "iterations\n")
>                         }
>            }
>            P.max <- P1
>         }
>         # find lower endpoint of CI
>         if(x == 0) P.min <- 0
>         else
>           {
>         OP <- (x+.5)/(n+1)
>         P0 <- OP - 1.8 * sqrt(OP * (1 - OP))/sqrt(n)
>         P1 <- OP - 1.9 * sqrt(OP * (1 - OP))/sqrt(n)
>         if(P0 < 0)
>                 P0 <- 0.050000000000000003
>         if(P1 < 0)
>                 P1 <- P0/2
>         done <- 0
>         iter <- 0
>
>         while(!done)
>                 {
>                 Y0 <- 1 - pbinom(x - 1, n, P0)
>                 Y1 <- 1 - pbinom(x - 1, n, P1)
>                 slope <- (Y1 - Y0)/(P1 - P0)
