Christian:
Here's some code I wrote to plot 2/3/2 where everything is symmetrically
centered.  You can readily edit it to get what you want.  Jeff.

#####################################################################

ruler <- seq(0,1,length=nrow(mc.mat))
par(omd=c(0,1,0,1),mfg=c(1,u, ,2),mfrow=c(3,3))
plot(ruler,mc.mat[,1],type="l",
        main="Variable 1",cex=.7,xlab="alpha",ylab="slope change")
plot(ruler,mc.mat[,2],type="l",
        main="Variable 2",cex=.7,xlab="alpha",ylab="slope change")

par(omd=c(0,2/3,1/3,2/3),mfg=c(1,1,1,2),new=T)
plot(ruler,mc.mat[,3],type="l",
        main="Variable 3",cex=.7,xlab="alpha",ylab="slope change")
par(omd=c(0,2/3,1/3,2/3),mfg=c(1,2,1,2),new=T)
plot(ruler,mc.mat[,4],type="l",
        main="Variable 4",cex=.7,xlab="alpha",ylab="slope change")
par(omd=c(0,2/3,1/3,2/3),mfg=c(1,3,1,2),new=T)
plot(ruler,mc.mat[,5],type="l",
        main="Variable 5",cex=.7,xlab="alpha",ylab="slope change")

par(omd=c(0.175,.825,2/3,3/3),mfg=c(3,1,1,2),new=T)
plot(ruler,mc.mat[,6],type="l",
        main="Variable 6",cex=.7,xlab="alpha",ylab="slope change")

par(omd=c(0.175,.825,2/3,3/3),mfg=c(3,2,1,2),new=T)
plot(ruler,mc.mat[,7],type="l",
        main="Variable 7",cex=.7,xlab="alpha",ylab="slope change")

