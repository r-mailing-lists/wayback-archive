                a1 * y + a2 * z + a3 * v))) - d4 * log(1 - pnorm(m2 - (a1 * y + 
a2 * z
+ 
                a3 * v))))      #
#Set up the Data Frame.
        fram <- data.frame(d1 = d1, d2 = d2, d3 = d3, d4 = d4, y = y, z = z, v
= v)    #
#Minimize the sum directly.
        g <- ms(frm, start = list(a1 = prs[1], a2 = prs[2], a3 = prs[3], m1 =
prs[4], 
                m2 = prs[5]), control = list(tolerance = 0.001, maxiter = 40), 
trace =
                T, data = fram) #

