Forgot to answer your second question:

dframe <- data.frame(y = rnorm(100), g = rep(letters[1:4], 25))
bwplot(g ~ y,
       data = dframe,
       panel = function(x, y) {
         q <- round(tapply(x, y, median), 3)
         text(q, unique(y) + .15, format(q, nsmall = 3))
         panel.bwplot(x, y)
       })

